    <li>Updated 9/27/2026</li>
</footer>
</div>
@code {
    private IReadOnlyList<Event> _upcoming = Array.Empty<Event>();
    private List<Event> _allEvents = new();
    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;
    private string? _adminMessage;
    private string? _adminError;
    private string _submittedBy = string.Empty;
    private bool _isLoggedIn;
    private string _loginName = string.Empty;
    private string? _loginError;
    private bool _loggingIn;
    private string? _editingId;
    private Event? _editSnapshot;
    private string? _addDraftEventId;
    private bool _dialogOpen;
    private bool _isEditDialog;
    private bool _pendingDialogFocus;
    private ScheduleEventForm? _eventFormRef;
    private ElementReference _dialogAnchorRef;
    private string _formSport = SportNames.Football;
    private readonly HashSet<string> _formKids = new(StringComparer.Ordinal);
    private DateTime _formDate = WashingtonScheduleTime.PacificToday;
    private string? _formStartTime;
    private string _formName = string.Empty;
    private string _formLocation = string.Empty;
    private readonly Dictionary<string, string> _themeBackgrounds = new(StringComparer.Ordinal);
    private string _kidThemeCss = string.Empty;
    private bool _savingThemes;
    private string? _themeMessage;
    private string? _themeError;
    private readonly Dictionary<string, KidThemeColorValidationIssue> _themeIssuesByKid =
        new(StringComparer.Ordinal);
    private CancellationTokenSource? _reloadCts;
    private readonly ScheduleLoadRetryPageState _loadRetry = new();

    public void Dispose()
    {
        _reloadCts?.Cancel();
        _reloadCts?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadKidThemesAsync();
        await RestoreSessionAuthAsync();
        await ReloadAsync();
    }

    private async Task RestoreSessionAuthAsync()
    {
        var name = await ScheduleSessionAuth.TryRestoreSignedInNameAsync(JS);
        if (name != null)
        {
            _submittedBy = name;
            _isLoggedIn = true;
        }
    }

    private void OnLoginNameInput(ChangeEventArgs e) =>
        _loginName = e.Value?.ToString() ?? string.Empty;

    private async Task OnLoginKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoginAsync();
        }
    }

    private async Task LoginAsync()
    {
        _loginError = null;
        if (!ScheduleSubmitters.TryValidateLoginFirstName(_loginName, out var normalized, out var error))
        {
            _loginError = error;
            return;
        }

        _loggingIn = true;
        try
        {
            var sessionToken = string.Equals(
                _loginName.Trim(),
                ScheduleSubmitters.LukeAuthCode,
                StringComparison.Ordinal)
                ? ScheduleSubmitters.LukeAuthCode
                : normalized;
            _submittedBy = sessionToken;
            _isLoggedIn = true;
            _loginName = string.Empty;
            await ScheduleSessionAuth.PersistSignedInNameAsync(JS, sessionToken);
        }
        finally
        {
            _loggingIn = false;
        }
    }

    private async Task SignOutAsync()
    {
        await ScheduleSessionAuth.ClearSignedInNameAsync(JS);
        _isLoggedIn = false;
        _submittedBy = string.Empty;
        _loginError = null;
        _adminMessage = null;
        _adminError = null;
        _themeMessage = null;
        _themeError = null;
        CloseDialog();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_pendingDialogFocus)
        {
            return;
        }

        _pendingDialogFocus = false;
        try
        {
            if (_eventFormRef != null)
            {
                await _eventFormRef.FocusFirstFieldAsync();
            }

            if (_isEditDialog && !string.IsNullOrEmpty(_editingId))
            {
                try
                {
                    await JS.InvokeVoidAsync("sportsScheduleAdmin.scrollToEditGroup", _editingId);
                }
                catch (JSException)
                {
                    // Cached sports-admin.js may lack scrollToEditGroup; ignore.
                }
            }
        }
        catch (Exception)
        {
            // Focus/scroll must not tear down the page if the dialog moved in the DOM.
        }
    }
    private static string GetEventRowId(Event evt) => $"event-row-{evt.Id}";

    private int ScheduleTableColumnCount => _isLoggedIn ? 6 : 4;

    private bool IsEditingGame(Event game) =>
        _isLoggedIn && _dialogOpen && _isEditDialog && _editingId == game.Id;

    private string GetScheduleRowClass(Event game)
    {
        var themeClass = ScheduleKidThemes.GetRowClass(game);
        return IsEditingGame(game)
            ? $"{themeClass} schedule-row-editing".Trim()
            : themeClass;
    }
    private async Task OpenAddDialogAsync()
    {
        if (_dialogOpen && _isEditDialog)
        {
            CloseDialog();
        }

        _isEditDialog = false;
        _editingId = null;
        _editSnapshot = null;
        _addDraftEventId = null;
        ClearForm();
        _adminError = null;
        _dialogOpen = true;
        _pendingDialogFocus = true;
        await InvokeAsync(StateHasChanged);
    }

    private Task CloseDialogFromBackdropAsync()
    {
        if (_saving)
        {
            return Task.CompletedTask;
        }

        CloseDialog();
        return Task.CompletedTask;
    }
    private async Task BeginEditAsync(Event evt)
    {
        if (_dialogOpen && _isEditDialog && _editingId == evt.Id)
        {
            CloseDialog();
            return;
        }
        _editingId = evt.Id;
        _isEditDialog = true;
        _editSnapshot = SnapshotEvent(evt);
        _addDraftEventId = null;
        _formSport = evt.Sport;
        _formKids.Clear();
        foreach (var kid in evt.Kids ?? new List<string>())
        {
            _formKids.Add(kid);
        }
        _formDate = evt.Date;
        _formName = evt.Name ?? string.Empty;
        _formLocation = evt.Location ?? string.Empty;
        _formStartTime = evt.StartTime.HasValue
            ? $"{evt.StartTime.Value.Hours:D2}:{evt.StartTime.Value.Minutes:D2}"
            : null;
        _adminError = null;
        _adminMessage = null;
        _dialogOpen = true;
        _pendingDialogFocus = true;
        await InvokeAsync(StateHasChanged);
    }
    private void CloseDialog()
    {
        _dialogOpen = false;
        _isEditDialog = false;
        _editingId = null;
        _editSnapshot = null;
        _addDraftEventId = null;
        _eventFormRef = null;
        ClearForm();
    }
    private Task OnKidToggledAsync((string Kid, bool Selected) args)
    {
        ToggleFormKid(args.Kid, args.Selected);
        return Task.CompletedTask;
    }
    private async Task LoadKidThemesAsync()
    {
        _themeError = null;
        try
        {
            var (data, error) = await KidThemeColorsApiClient.LoadAsync(Http);
            ApplyThemeData(data);
            if (error != null)
            {
                _themeError = error;
            }
        }
        catch (Exception)
        {
            ApplyThemeData(KidThemeColors.CreateDefaultData());
            _themeError = "Could not load kid colors. Using defaults.";
        }
    }
    private void ApplyThemeData(KidThemeColorsData data)
    {
        KidThemeColorsLoader.Apply(data);
        _themeBackgrounds.Clear();
        foreach (var kid in ScheduleKids.AllowedKids)
        {
            _themeBackgrounds[kid] = KidThemeColors.GetBackgroundHex(kid);
        }
        _kidThemeCss = KidThemeColorsLoader.CombinedPageCss();
        RefreshThemeColorValidation();
    }
    private void RefreshThemeColorValidation()
    {
        _themeIssuesByKid.Clear();
        foreach (var pair in KidColorSuggestions.ValidateAllBackgrounds(BuildThemeDataFromEditor().BackgroundByKid))
        {
            _themeIssuesByKid[pair.Key] = pair.Value;
        }
    }
    private string GetThemeColor(string kid) =>
        _themeBackgrounds.TryGetValue(kid, out var hex) ? hex : KidThemeColors.GetBackgroundHex(kid);
    private void OnKidColorChanged(string kid, string? hex)
    {
        if (string.IsNullOrWhiteSpace(hex) || !KidThemeColors.IsValidHex(hex))
        {
            return;
        }
        _themeBackgrounds[kid] = hex;
        _themeMessage = null;
        _themeError = null;
        ApplyThemeData(BuildThemeDataFromEditor());
    }
    private void ApplySuggestedThemeColor(string kid, string suggestedHex)
    {
        if (!KidThemeColors.IsValidHex(suggestedHex))
        {
            return;
        }
        _themeBackgrounds[kid] = suggestedHex;
        _themeMessage = null;
        _themeError = null;
        ApplyThemeData(BuildThemeDataFromEditor());
    }
    private KidThemeColorsData BuildThemeDataFromEditor() =>
        new KidThemeColorsData
        {
            BackgroundByKid = ScheduleKids.AllowedKids.ToDictionary(
                k => k,
                k => GetThemeColor(k),
                StringComparer.Ordinal)
        };
    private async Task SaveKidThemesAsync()
    {
        _themeMessage = null;
        _themeError = null;
        if (!TryGetValidatedSubmitter(out var submittedBy))
        {
            _themeError = _adminError;
            return;
        }
        var payload = BuildThemeDataFromEditor();
        RefreshThemeColorValidation();
        if (_themeIssuesByKid.Count > 0)
        {
            _themeError = KidThemeColors.FormatColorRuleError(_themeIssuesByKid);
            return;
        }
        if (!KidThemeColors.TryValidateWrite(payload, out var validationError))
        {
            _themeError = validationError;
            return;
        }
        _savingThemes = true;
        try
        {
            var (data, error) = await KidThemeColorsApiClient.SaveAsync(Http, submittedBy, payload);
            if (error != null)
            {
                if (KidThemeColorsValidationError.TryParse(error, out var apiValidation)
                    && apiValidation!.IssuesByKid.Count > 0)
                {
                    _themeIssuesByKid.Clear();
                    foreach (var pair in apiValidation.IssuesByKid)
                    {
                        _themeIssuesByKid[pair.Key] = pair.Value;
                    }
                    _themeError = apiValidation.Error;
                }
                else
                {
                    _themeError = error;
                }
                return;
            }
            ApplyThemeData(data!);
            _themeMessage = "Kid colors saved.";
        }
        finally
        {
            _savingThemes = false;
        }
    }
    private Task OnScheduleLoadRetryWaitingAsync(ScheduleLoadRetryUpdate update)
    {
        _loading = false;
        _errorMessage = null;
        _loadRetry.ApplyWaiting(update);
        return InvokeAsync(StateHasChanged);
    }

    private async Task ReloadAsync()
    {
        _reloadCts?.Cancel();
        _reloadCts?.Dispose();
        _reloadCts = new CancellationTokenSource();
        var ct = _reloadCts.Token;

        _loading = true;
        _errorMessage = null;
        _loadRetry.Clear();
        try
        {
            var (data, error) = await SportsScheduleApiClient.LoadAllWithRetryAsync(
                Http,
                OnScheduleLoadRetryWaitingAsync,
                ct);
            if (error != null)
            {
                _errorMessage = error;
                _upcoming = Array.Empty<Event>();
                _allEvents = new List<Event>();
            }
            else
            {
                _loadRetry.Clear();
                _allEvents = data.Events ?? new List<Event>();
                _upcoming = SportsSchedules.GetUpcoming(_allEvents);
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        catch (Exception)
        {
            _errorMessage = "Could not display the schedule. Try reloading the page.";
            _upcoming = Array.Empty<Event>();
            _allEvents = new List<Event>();
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                _loading = false;
            }
        }
    }
    private string FormStartTimeString =>
        _formStartTime ?? (_formDate.TimeOfDay == TimeSpan.Zero ? string.Empty : _formDate.ToString("HH:mm"));
    private IReadOnlyList<string> FormSportOptions =>
        _allEvents
            .Select(e => e.Sport)
            .Concat(SportNames.Defaults)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IReadOnlyList<string> FormLocationSuggestions =>
        ScheduleLocationSuggestions.Build(_allEvents);

    private IReadOnlyList<string> FormLocationAutocomplete =>
        ScheduleLocationSuggestions.BuildAutocompleteList(_allEvents);

    private Task OnFormSportChangedAsync(string sport)
    {
        _formSport = sport;
        return Task.CompletedTask;
    }

    private Event BuildFormEvent() =>
        new Event
        {
            Sport = SportNames.NormalizeOrDefault(_formSport),
            Kids = ScheduleKids.NormalizeKidsList(_formKids),
            Date = _formDate.Date,
            Name = _formName,
            Location = _formLocation,
            StartTime = ParseStartTime(_formStartTime)
        };
    private static TimeSpan? ParseStartTime(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return ScheduleEventPickers.TryParseTimeFromStorage(value, out var ts) ? ts : null;
    }
    private async Task AutoSaveFormAsync()
    {
        if (!_dialogOpen || _saving)
        {
            return;
        }

        if (!FormIsValidForSave())
        {
            if (FormHasRequiredFields()
                && WashingtonScheduleTime.IsEventInPast(_formDate, ParseStartTime(_formStartTime)))
            {
                _adminError = WashingtonScheduleTime.PastEventMessage;
                await InvokeAsync(StateHasChanged);
            }

            return;
        }

        if (!TryGetValidatedSubmitter(out var submittedBy))
        {
            return;
        }

        ClearPastEventErrorIfResolved();
        _saving = true;
        try
        {
            if (_isEditDialog)
            {
                if (_editingId == null)
                {
                    return;
                }

                var (_, error) = await SportsScheduleApiClient.UpdateEventAsync(
                    Http,
                    _editingId,
                    submittedBy,
                    BuildFormEvent());
                if (error != null)
                {
                    _adminError = SanitizeAdminError(error);
                    return;
                }

                await ReloadAsync();
                return;
            }

            var payload = BuildFormEvent();
            if (_addDraftEventId == null)
            {
                var existingIds = _allEvents.Select(e => e.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
                var (data, error) = await SportsScheduleApiClient.AddEventAsync(Http, submittedBy, payload);
                if (error != null)
                {
                    _adminError = SanitizeAdminError(error);
                    return;
                }

                _addDraftEventId = FindNewEventId(data, payload, existingIds);
                _adminMessage = "Event added.";
                await ReloadAsync();
                return;
            }

            var (_, updateError) = await SportsScheduleApiClient.UpdateEventAsync(
                Http,
                _addDraftEventId,
                submittedBy,
                payload);
            if (updateError != null)
            {
                _adminError = SanitizeAdminError(updateError);
                return;
            }

            await ReloadAsync();
        }
        finally
        {
            _saving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task UndoAllFormChangesAsync()
    {
        if (_saving || !_dialogOpen)
        {
            return;
        }

        if (!TryGetValidatedSubmitter(out var submittedBy))
        {
            return;
        }

        _adminError = null;
        _adminMessage = null;
        _saving = true;
        try
        {
            if (_isEditDialog && _editSnapshot != null && _editingId != null)
            {
                ApplyEventToForm(_editSnapshot);
                var (_, error) = await SportsScheduleApiClient.UpdateEventAsync(
                    Http,
                    _editingId,
                    submittedBy,
                    BuildFormEvent());
                if (error != null)
                {
                    _adminError = SanitizeAdminError(error);
                    return;
                }

                _adminMessage = "Changes undone.";
                await ReloadAsync();
                return;
            }

            if (!string.IsNullOrEmpty(_addDraftEventId))
            {
                var (_, deleteError) = await SportsScheduleApiClient.DeleteEventAsync(
                    Http,
                    _addDraftEventId,
                    submittedBy);
                if (deleteError != null)
                {
                    _adminError = SanitizeAdminError(deleteError);
                    return;
                }

                _addDraftEventId = null;
            }

            ClearForm();
            _adminMessage = "Changes undone.";
            await ReloadAsync();
        }
        finally
        {
            _saving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool FormIsValidForSave() =>
        !string.IsNullOrWhiteSpace(_formName)
        && _formKids.Count > 0
        && SportNames.TryNormalize(_formSport, out _)
        && !WashingtonScheduleTime.IsEventInPast(_formDate, ParseStartTime(_formStartTime));

    private bool FormHasRequiredFields() =>
        !string.IsNullOrWhiteSpace(_formName)
        && _formKids.Count > 0
        && SportNames.TryNormalize(_formSport, out _);

    private Task OnFormDateChangedAsync(DateTime date)
    {
        if (date.Date < WashingtonScheduleTime.PacificToday)
        {
            _adminError = WashingtonScheduleTime.PastEventMessage;
            return InvokeAsync(StateHasChanged);
        }

        _formDate = date.Date;
        if (WashingtonScheduleTime.IsEventInPast(_formDate, ParseStartTime(_formStartTime)))
        {
            _adminError = WashingtonScheduleTime.PastEventMessage;
        }
        else
        {
            ClearPastEventErrorIfResolved();
        }

        return Task.CompletedTask;
    }

    private void OnStartTimeChanged(ChangeEventArgs e)
    {
        _formStartTime = e.Value?.ToString();
        ClearPastEventErrorIfResolved();
        if (FormHasRequiredFields()
            && WashingtonScheduleTime.IsEventInPast(_formDate, ParseStartTime(_formStartTime)))
        {
            _adminError = WashingtonScheduleTime.PastEventMessage;
        }
    }

    private void ClearPastEventErrorIfResolved()
    {
        if (_adminError == WashingtonScheduleTime.PastEventMessage
            && !WashingtonScheduleTime.IsEventInPast(_formDate, ParseStartTime(_formStartTime)))
        {
            _adminError = null;
        }
    }

    private static Event SnapshotEvent(Event source) =>
        new Event
        {
            Id = source.Id,
            Sport = source.Sport,
            Date = source.Date,
            StartTime = source.StartTime,
            Name = source.Name ?? string.Empty,
            Location = source.Location ?? string.Empty,
            Kids = source.Kids?.ToList() ?? new List<string>()
        };

    private void ApplyEventToForm(Event source)
    {
        _formSport = source.Sport;
        _formKids.Clear();
        foreach (var kid in source.Kids ?? new List<string>())
        {
            _formKids.Add(kid);
        }

        _formDate = ScheduleEventPickers.NormalizeSelectableDate(source.Date);
        _formName = source.Name ?? string.Empty;
        _formLocation = source.Location ?? string.Empty;
        if (source.StartTime.HasValue
            && !WashingtonScheduleTime.IsEventInPast(_formDate, source.StartTime))
        {
            _formStartTime = ScheduleEventPickers.FormatTimeForStorage(source.StartTime.Value);
        }
        else
        {
            _formStartTime = null;
        }
    }

    private static string? FindNewEventId(
        SportsSchedulesData? data,
        Event template,
        HashSet<string> existingIds)
    {
        if (data?.Events == null)
        {
            return null;
        }

        foreach (var candidate in data.Events)
        {
            if (existingIds.Contains(candidate.Id))
            {
                continue;
            }

            if (EventsMatchForDraft(candidate, template))
            {
                return candidate.Id;
            }
        }

        return data.Events
            .Select(e => e.Id)
            .FirstOrDefault(id => !existingIds.Contains(id));
    }

    private static bool EventsMatchForDraft(Event left, Event right)
    {
        if (left.Sport != right.Sport || left.Date.Date != right.Date.Date)
        {
            return false;
        }

        if (!string.Equals(left.Name?.Trim(), right.Name?.Trim(), StringComparison.Ordinal))
        {
            return false;
        }

        var leftKids = ScheduleKids.NormalizeKidsList(left.Kids);
        var rightKids = ScheduleKids.NormalizeKidsList(right.Kids);
        return leftKids.SequenceEqual(rightKids, StringComparer.Ordinal);
    }
    private async Task DeleteEventAsync(Event evt)
    {
        _adminError = null;
        _adminMessage = null;
        if (!TryGetValidatedSubmitter(out var submittedBy))
        {
            return;
        }

        var confirmMessage = string.IsNullOrWhiteSpace(evt.Name)
            ? "Delete this event?"
            : $"Delete \"{evt.Name}\"?";
        var confirmed = await JS.InvokeAsync<bool>("scheduleAuth.confirmDelete", confirmMessage);
        if (!confirmed)
        {
            return;
        }

        _saving = true;
        try
        {
            var (_, error) = await SportsScheduleApiClient.DeleteEventAsync(Http, evt.Id, submittedBy);
            if (error != null)
            {
                _adminError = SanitizeAdminError(error);
                return;
            }
            _adminMessage = "Event deleted.";
            if (_editingId == evt.Id)
            {
                CloseDialog();
            }
            await ReloadAsync();
        }
        finally
        {
            _saving = false;
        }
    }
    private void ClearForm()
    {
        _formSport = SportNames.Football;
        _formKids.Clear();
        _formDate = WashingtonScheduleTime.PacificToday;
        _formStartTime = null;
        _formName = string.Empty;
        _formLocation = string.Empty;
    }
    private void ToggleFormKid(string kid, bool selected)
    {
        if (selected)
        {
            _formKids.Add(kid);
        }
        else
        {
            _formKids.Remove(kid);
        }
    }
    private string SignedInDisplayName =>
        string.Equals(_submittedBy, ScheduleSubmitters.LukeAuthCode, StringComparison.Ordinal)
            ? "Luke"
            : _submittedBy;

    private static string? SanitizeAdminError(string? error)
    {
        if (string.Equals(error, ScheduleSubmitters.FakeLukeMessage, StringComparison.Ordinal))
        {
            return ScheduleSubmitters.InvalidSessionMessage;
        }

        return error;
    }

    /// <summary>
    /// Ensures the current session is valid and returns the value to send as <c>submittedBy</c> on API writes
    /// (session token <c>1123</c> for Luke, not the normalized display name).
    /// </summary>
    private bool TryGetValidatedSubmitter(out string submittedByForApi)
    {
        submittedByForApi = string.Empty;
        if (!ScheduleSubmitters.TryResolveSubmitterForWrite(_submittedBy, out _, out var error))
        {
            _adminError = SanitizeAdminError(error);
            return false;
        }

        submittedByForApi = _submittedBy.Trim();
        return true;
    }
