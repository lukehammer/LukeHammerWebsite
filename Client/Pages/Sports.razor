                    <div class="event-form-dialog" @ref="_dialogAnchorRef">
                        <ScheduleEventForm @ref="_eventFormRef"
                                           IsEdit="true"
                                           ShowSubmittedByField="false"
                                           Saving="@_saving"
                                           ErrorMessage="@_adminError"
                                           Sport="@_formSport"
                                           SportChanged="OnFormSportChangedAsync"
                                           SportOptions="@FormSportOptions"
                                           LocationSuggestions="@FormLocationSuggestions"
                               LocationAutocomplete="@FormLocationAutocomplete"
                                           SelectedKids="@_formKids"
                                           Date="@_formDate"
                                           DateChanged="OnFormDateChangedAsync"
                                           StartTimeString="@FormStartTimeString"
                                           StartTimeChanged="OnStartTimeChanged"
                                           Name="@_formName"
                                           NameChanged="v => _formName = v"
                                           Location="@_formLocation"
                                           LocationChanged="v => _formLocation = v"
                                           OnKidToggled="OnKidToggledAsync"
                                           OnFieldCommitted="AutoSaveFormAsync"
                                           ShowUndoAll="true"
                                           OnUndoAll="UndoAllFormChangesAsync"
                                           OnCancel="CloseDialog" />
                    </div>
                </td>
            </tr>
        }
    }
    </tbody>
</table>
</div>
}
</div>
@if (_isLoggedIn)
{
<section class="admin-panel">
    <h2>Row colors</h2>
    <p>Background color for each kid&apos;s schedule rows and multi-kid stripes.</p>
    <div class="kid-color-section">
        <div class="kid-color-grid">
            @foreach (var kid in ScheduleKids.AllowedKids)
