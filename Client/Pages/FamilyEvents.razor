        editingBringText = "";
    }

    /// <summary>Shows the problem under the name box and moves the cursor there.</summary>
    private bool RequireName()
    {
        if (!string.IsNullOrWhiteSpace(name))
        {
            return true;
        }

        ShowError("name", "Please enter your name first.", isUnexpected: false);
        _ = nameInput.FocusAsync();
        return false;
    }

    /// <summary>
    /// Shows an error next to the part of the page it came from (<paramref name="area"/>; null means the top).
    /// Unexpected errors also tell people in production to call Luke.
    /// </summary>
    private void ShowError(string? area, string message, bool isUnexpected)
    {
        errorMessage = message;
        errorArea = area;
        errorIsUnexpected = isUnexpected;
        successMessage = null;
    }

    private RenderFragment ErrorMessageFor(string? area) => @<text>
        @if (!string.IsNullOrWhiteSpace(errorMessage) && errorArea == area)
        {
            <div class="family-inline-error" role="alert">
                @if (errorIsUnexpected && HostEnvironment.IsProduction())
                {
                    <p class="family-inline-error-title">
                        Something went horribly wrong. Call Luke at <a href="tel:+15035053005">503.505.3005</a> to get this fixed.
                    </p>
                    <p class="family-inline-error-detail">Error: @errorMessage</p>
                }
                else
                {
                    <p class="family-inline-error-detail">@errorMessage</p>
                }
            </div>
        }
    </text>;

    private string EventApi(string suffix = "") =>
        $"/api/family-events/{Uri.EscapeDataString(SelectedEvent!.Id)}{suffix}";

    /// <summary>
    /// Sends a write and replaces the local event list with the server's copy on success. On failure the
    /// error shows in <paramref name="area"/>. Requests the server rejected with a reason (4xx) are things
    /// the person can fix; anything else is unexpected.
    /// </summary>
    private async Task<bool> SendAsync(Func<Task<HttpResponseMessage>> send, string failure, string area)
    {
        errorMessage = null;
        successMessage = null;
        isBusy = true;
        try
        {
            var result = await send();
            if (!result.IsSuccessStatusCode)
            {
                var message = (await result.Content.ReadAsStringAsync()).Trim();
                var statusCode = (int)result.StatusCode;
                var isUnexpected = statusCode >= 500 || message.Length == 0 || message.StartsWith("<");
                var detail = isUnexpected
                    ? $"{failure} The server answered {statusCode} {result.ReasonPhrase}{(message.Length == 0 || message.StartsWith("<") ? "." : $": {message}")}"
                    : message;
                if (result.StatusCode == System.Net.HttpStatusCode.Conflict)
                {
                    await LoadAsync();
                }

                ShowError(area, detail, isUnexpected);
                return false;
            }

            response = await result.Content.ReadFromJsonAsync<FamilyEventsResponse>() ?? response;
            return true;
        }
        catch (Exception ex)
        {
            ShowError(area, $"{failure} {ex.GetType().Name}: {ex.Message}", isUnexpected: true);
            return false;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RememberName() =>
        await JS.InvokeVoidAsync("localStorage.setItem", NameStorageKey, name.Trim());

    private async Task SaveParticipant()
    {
        if (!RequireName())
        {
            return;
        }

        var ok = await SendAsync(
            () => Http.PostAsJsonAsync(EventApi("/participant"), new PotluckParticipantRequest { Name = name.Trim(), Bringing = bringing }),
            "Could not save your info.", "bring");

        if (ok)
        {
            await RememberName();
            successMessage = string.IsNullOrWhiteSpace(bringing)
                ? $"Saved, {name.Trim()}."
                : $"Saved, {name.Trim()}. You are bringing {bringing.Trim()}.";
        }
    }

    private async Task SaveBringEdit(string participantName)
    {
        var updated = editingBringText.Trim();
        var ok = await SendAsync(
            () => Http.PostAsJsonAsync(EventApi("/participant"), new PotluckParticipantRequest { Name = participantName.Trim(), Bringing = updated }),
            "Could not update that item.", "bring-table");

        if (ok)
        {
            if (string.Equals(name.Trim(), participantName.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                bringing = updated;
            }

            CancelBringEdit();
            successMessage = string.IsNullOrWhiteSpace(updated)
                ? $"Cleared what {participantName.Trim()} is bringing."
                : $"Updated what {participantName.Trim()} is bringing.";
        }
    }

    private async Task RateOption(string optionId, int direction)
    {
        if (!RequireName())
        {
            return;
        }

        var current = GetUserRating(optionId);
        var newRating = direction > 0
            ? current == 1 ? 0 : 1
            : current == -1 ? 0 : -1;

        var ok = await SendAsync(
            () => Http.PostAsJsonAsync(EventApi("/rate"), new PotluckRateRequest { Name = name.Trim(), OptionId = optionId, Rating = newRating }),
            "Could not save your vote.",
            "themes");

        if (ok)
        {
            await RememberName();
        }
    }

    private async Task AddOtherOption()
    {
        if (!RequireName())
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(otherText))
        {
            ShowError("themes", "Please enter a new potluck option.", isUnexpected: false);
            return;
        }

        var ok = await SendAsync(
            () => Http.PostAsJsonAsync(EventApi("/options"), new PotluckAddOptionRequest { Label = otherText.Trim(), CreatedBy = name.Trim() }),
            "Could not add that option.", "themes");

        if (ok)
        {
            otherText = "";
            successMessage = "New option added.";
        }
    }

    private async Task RemoveOption(string optionId)
    {
        var ok = await SendAsync(
            () => Http.PostAsJsonAsync(EventApi("/options/remove"), new PotluckRemoveOptionRequest { OptionId = optionId }),
            "Could not remove that option.", "themes");

        if (ok)
        {
            successMessage = "Option removed.";
        }
    }

    private static string FormatPostTime(DateTimeOffset value) =>
        WashingtonScheduleTime.ToPacific(value).ToString("MMM d, h:mm tt", DisplayCulture);

    private string GetAnswerDraft(string questionId) =>
        answerDrafts.TryGetValue(questionId, out var draft) ? draft : string.Empty;

    private string DeleteRequester => isLuke ? ScheduleSubmitters.LukeAuthCode : name.Trim();

    private bool CanDelete(string author) =>
        !IsLocked && FamilyEventRules.CanDeletePost(author, DeleteRequester);

    private FamilyEventRsvpRequest BuildRsvpRequest() => new()
    {
        Name = name.Trim(),
        Status = rsvpStatus,
        Headcount = rsvpHeadcount,
        Attendees = rsvpAttendees
            .Take(AttendeeRowCount)
            .Select(a => new FamilyEventAttendee { Name = a.Name, Age = a.Age })
            .ToList(),
        Note = rsvpNote
    };

    private static string DescribeRsvpRequest(FamilyEventRsvpRequest request) =>
        System.Text.Json.JsonSerializer.Serialize(request);

    private async Task PickRsvpStatus(string status)
    {
        rsvpStatus = status;
        await AutoSaveRsvp();
    }

    /// <summary>
    /// Saves the RSVP if it changed since the last save. Saves run one at a time; a change made while a
    /// save is in flight is saved right after it.
    /// </summary>
    private async Task AutoSaveRsvp()
    {
        if (IsLocked || string.IsNullOrEmpty(rsvpStatus))
        {
            return;
        }

        if (!await rsvpWriteLock.WaitAsync(0))
        {
            rsvpSavePending = true;
            return;
        }

        try
        {
            do
            {
                rsvpSavePending = false;
                var request = BuildRsvpRequest();
                var snapshot = DescribeRsvpRequest(request);
                if (snapshot == lastSavedRsvp)
                {
                    continue;
                }

                if (!RequireName())
                {
                    return;
                }

                rsvpSaveStatus = "Saving…";
                StateHasChanged();
                var ok = await SendAsync(
                    () => Http.PostAsJsonAsync(EventApi("/rsvp"), request),
                    "Could not save your RSVP.", "rsvp");
                if (!ok)
                {
                    rsvpSaveStatus = "Not saved.";
                    return;
                }

                lastSavedRsvp = snapshot;
                rsvpSaveStatus = "Your RSVP is saved.";
                await RememberName();
            }
            while (rsvpSavePending);
        }
        finally
        {
            rsvpWriteLock.Release();
        }
    }

    private async Task RemoveRsvp()
    {
        await rsvpWriteLock.WaitAsync();
        try
        {
            rsvpSavePending = false;
            var ok = await SendAsync(
                () => Http.PostAsJsonAsync(EventApi("/rsvp"), new FamilyEventRsvpRequest { Name = name.Trim(), Status = "" }),
                "Could not remove your RSVP.", "rsvp");

            if (ok)
            {
                LoadParticipant(name);
                successMessage = "Your RSVP was removed.";
            }
        }
        finally
        {
            rsvpWriteLock.Release();
        }
    }

    private async Task SaveSignup(string listId, string text)
    {
        if (!RequireName())
        {
            return;
        }

        var ok = await SendAsync(
            () => Http.PostAsJsonAsync(
                EventApi($"/signups/{Uri.EscapeDataString(listId)}"),
                new FamilyEventPostRequest { Name = name.Trim(), Text = text }),
            "Could not save your sign-up.",
            $"signup:{listId}");

        if (ok)
        {
            signupDrafts.Remove(listId);
            await RememberName();
            successMessage = string.IsNullOrWhiteSpace(text) ? "Sign-up removed." : "Sign-up saved.";
        }
    }

    private async Task AskQuestion()
    {
        if (!RequireName())
        {
            return;
        }

        var ok = await SendAsync(
            () => Http.PostAsJsonAsync(EventApi("/questions"), new FamilyEventPostRequest { Name = name.Trim(), Text = newQuestionText }),
            "Could not post your question.", "qa");

        if (ok)
        {
            newQuestionText = "";
            await RememberName();
            successMessage = "Question posted.";
        }
    }

    private async Task AnswerQuestion(string questionId)
    {
        if (!RequireName())
        {
            return;
        }

        var ok = await SendAsync(
            () => Http.PostAsJsonAsync(
                EventApi($"/questions/{Uri.EscapeDataString(questionId)}/answers"),
                new FamilyEventPostRequest { Name = name.Trim(), Text = GetAnswerDraft(questionId) }),
            "Could not post your answer.", $"qa:{questionId}");

        if (ok)
        {
            answerDrafts.Remove(questionId);
            await RememberName();
            successMessage = "Answer posted.";
        }
    }

    private RenderFragment VoteControls(Dictionary<string, int> votes, string postKind, Func<int, Task> castVote)
    {
        var myVote = FamilyEventVotes.VoteBy(votes, name);
        var score = FamilyEventVotes.Score(votes);
        var scoreClass = score > 0 ? "is-positive" : score < 0 ? "is-negative" : "";
        return @<div class="family-vote" role="group" aria-label="Votes on this @postKind">
            @if (!IsLocked)
            {
                <button type="button"
                        class="family-vote-btn is-up @(myVote == FamilyEventVotes.Up ? "is-active" : "")"
                        aria-label="Upvote this @postKind"
                        aria-pressed="@(myVote == FamilyEventVotes.Up ? "true" : "false")"
                        disabled="@isBusy"
                        @onclick="() => castVote(FamilyEventVotes.Up)">&#9650;</button>
            }
            <span class="family-vote-score @scoreClass" title="Score: upvotes minus downvotes">@score</span>
            @if (!IsLocked)
            {
                <button type="button"
                        class="family-vote-btn is-down @(myVote == FamilyEventVotes.Down ? "is-active" : "")"
                        aria-label="Downvote this @postKind"
                        aria-pressed="@(myVote == FamilyEventVotes.Down ? "true" : "false")"
                        disabled="@isBusy"
                        @onclick="() => castVote(FamilyEventVotes.Down)">&#9660;</button>
            }
        </div>;
    }

    private Task VoteOnQuestion(FamilyEventQuestion question, int vote) =>
        SendVote($"/questions/{Uri.EscapeDataString(question.Id)}/vote", question.Votes, vote, $"qa:{question.Id}");

    private Task VoteOnAnswer(FamilyEventQuestion question, FamilyEventAnswer answer, int vote) =>
        SendVote($"/questions/{Uri.EscapeDataString(question.Id)}/answers/{Uri.EscapeDataString(answer.Id)}/vote", answer.Votes, vote, $"qa:{question.Id}");

    /// <summary>Tapping the arrow you already picked takes your vote back, like Reddit.</summary>
    private async Task SendVote(string path, Dictionary<string, int> votes, int vote, string area)
    {
        if (!RequireName())
        {
            return;
        }

        var newVote = FamilyEventVotes.VoteBy(votes, name) == vote ? 0 : vote;
        var ok = await SendAsync(
            () => Http.PostAsJsonAsync(EventApi(path), new FamilyEventVoteRequest { Name = name.Trim(), Vote = newVote }),
            "Could not save your vote.",
            area);

        if (ok)
        {
            await RememberName();
        }
    }

    private async Task DeleteQuestion(FamilyEventQuestion question)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this question and all of its answers?"))
        {
            return;
        }

        var ok = await SendAsync(
            () => Http.PostAsJsonAsync(
                EventApi($"/questions/{Uri.EscapeDataString(question.Id)}/delete"),
                new FamilyEventDeletePostRequest { Name = DeleteRequester }),
            "Could not delete that question.", $"qa:{question.Id}");

        if (ok)
        {
            successMessage = "Question deleted.";
        }
    }

