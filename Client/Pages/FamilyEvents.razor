    protected override async Task OnInitializedAsync()
    {
        isLuke = await ScheduleSessionAuth.TryRestoreSignedInNameAsync(JS) == ScheduleSubmitters.LukeAuthCode;
        await LoadAsync();

        var savedName = await JS.InvokeAsync<string?>("localStorage.getItem", NameStorageKey);
        if (!string.IsNullOrWhiteSpace(savedName))
        {
            LoadParticipant(savedName);
        }
    }

    protected override void OnParametersSet()
    {
        CancelBringEdit();
        signupDrafts.Clear();
        answerDrafts.Clear();
        if (!string.IsNullOrWhiteSpace(name))
        {
            LoadParticipant(name);
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            response = await Http.GetFromJsonAsync<FamilyEventsResponse>("/api/family-events")
                ?? new FamilyEventsResponse();
            errorMessage = null;
        }
        catch (Exception ex)
        {
            ShowError(null, $"Could not load events. {ex.GetType().Name}: {ex.Message}", isUnexpected: true);
            response = new FamilyEventsResponse { Today = DateTime.Today };
        }
    }

    private List<FamilyEvent> UpcomingEvents => FamilyEventRules.Upcoming(response?.Events ?? new(), Today);

    private List<FamilyEvent> PastEvents => FamilyEventRules.Past(response?.Events ?? new(), Today);

    private DateTime Today => response?.Today ?? DateTime.Today;

    private FamilyEvent? SelectedEvent
    {
        get
        {
            var events = response?.Events ?? new List<FamilyEvent>();
            return events.FirstOrDefault(e => string.Equals(e.Id, EventId, StringComparison.OrdinalIgnoreCase))
                ?? FamilyEventRules.PickDefault(events, Today);
        }
    }

    private bool IsLocked => SelectedEvent != null && FamilyEventRules.IsLocked(SelectedEvent.Date, Today);

    private string SelectedTheme => SelectedEvent == null ? FamilyEventTheme.None : FamilyEventTheme.For(SelectedEvent);

    private List<PotluckOptionRow> SortedOptionRows =>
