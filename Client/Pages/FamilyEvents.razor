    private static string MapUrl(string location) =>
        "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(location);

    private static string FormatWhen(FamilyEvent familyEvent)
    {
        var date = familyEvent.IsMultiDay
            ? $"{familyEvent.Date.ToString("dddd, MMMM d", DisplayCulture)} – {familyEvent.LastDay.ToString("dddd, MMMM d, yyyy", DisplayCulture)}"
            : familyEvent.Date.ToString("dddd, MMMM d, yyyy", DisplayCulture);
        return familyEvent.StartTime.HasValue
            ? $"{date} at {ScheduleDateDisplay.FormatStartTime(familyEvent.StartTime)}"
            : date;
    }

    private static string FormatPickerLabel(FamilyEvent familyEvent)
    {
        var date = familyEvent.IsMultiDay
            ? $"{familyEvent.Date.ToString("MMM d", DisplayCulture)}–{familyEvent.LastDay.ToString(familyEvent.LastDay.Month == familyEvent.Date.Month ? "d, yyyy" : "MMM d, yyyy", DisplayCulture)}"
            : familyEvent.Date.ToString("MMM d, yyyy", DisplayCulture);
        return $"{date} — {familyEvent.Title}";
    }

    private static string RsvpLabel(string status) => status switch
    {
        FamilyRsvpStatus.Going => "Going",
        FamilyRsvpStatus.Maybe => "Maybe",
        _ => "Can't make it"
    };

    private static int RsvpOrder(string status) => status switch
    {
        FamilyRsvpStatus.Going => 0,
        FamilyRsvpStatus.Maybe => 1,
        _ => 2
    };

    private FamilyEventRsvp? FindRsvp(string participantName) =>
        string.IsNullOrWhiteSpace(participantName)
            ? null
            : SelectedEvent?.Rsvps.FirstOrDefault(r => string.Equals(r.Name, participantName.Trim(), StringComparison.OrdinalIgnoreCase));

    private static FamilyEventSignupEntry? FindSignup(FamilyEventSignupList list, string participantName) =>
        string.IsNullOrWhiteSpace(participantName)
            ? null
            : list.Entries.FirstOrDefault(e => string.Equals(e.Name, participantName.Trim(), StringComparison.OrdinalIgnoreCase));

    private string GetSignupDraft(string listId, FamilyEventSignupEntry? mine) =>
