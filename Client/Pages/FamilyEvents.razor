@page "/FamilyEvents"
@page "/FamilyEvents/{EventId}"
@using System.Globalization
@using BlazorApp.Shared
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IWebAssemblyHostEnvironment HostEnvironment

<PageTitle>@(SelectedEvent?.Title ?? "Family Events")</PageTitle>
<HeadContent>
    <link rel="icon" type="image/png" sizes="96x96" href="icons/hammer-family-events-96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="icons/hammer-family-events-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="icons/hammer-family-events-180.png" />
</HeadContent>

@if (SelectedTheme != FamilyEventTheme.None)
{
    <div class="family-theme-backdrop is-@SelectedTheme" aria-hidden="true"></div>
}

<main class="camping-page @(SelectedTheme != FamilyEventTheme.None ? $"family-theme is-{SelectedTheme}" : "")">
    <h1>Family Events</h1>
    <SchedulePwaInstallPrompt Message="Add Family Events to your home screen for one-tap access." />

    @ErrorMessageFor(null)

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <p class="camping-success">@successMessage</p>
    }

    @if (response == null)
    {
        <p>Loading events...</p>
    }
    else
    {
        @if (response.Events.Count > 0)
        {
            <div class="camping-field family-event-picker">
                <label for="event-picker">Event</label>
                <select id="event-picker" class="form-select camping-input" value="@SelectedEvent?.Id" @onchange="OnEventPicked">
                    @if (UpcomingEvents.Count > 0)
                    {
                        <optgroup label="Upcoming">
                            @foreach (var familyEvent in UpcomingEvents)
                            {
                                <option value="@familyEvent.Id">@FormatPickerLabel(familyEvent)</option>
                            }
                        </optgroup>
                    }
                    @if (PastEvents.Count > 0)
                    {
                        <optgroup label="Past">
                            @foreach (var familyEvent in PastEvents)
                            {
                                <option value="@familyEvent.Id">@FormatPickerLabel(familyEvent)</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
        }

        @if (editor != null)
        {
            <section class="camping-card">
                <h2>@(editor.IsNew ? "New event" : "Edit event")</h2>
                <div class="camping-field">
                    <label for="evt-title">Title</label>
                    <input id="evt-title" class="form-control camping-input" @bind="editor.Title" placeholder="e.g. Hammer Thanksgiving Potluck" />
                </div>
                <div class="family-event-row">
                    <div class="camping-field">
                        <label for="evt-date">Date</label>
                        <input id="evt-date" type="date" class="form-control camping-input" @bind="editor.Date" />
                    </div>
                    <div class="camping-field">
                        <label for="evt-end-date">Last day (multi-day events)</label>
                        <input id="evt-end-date" type="date" class="form-control camping-input" @bind="editor.EndDate" />
                    </div>
                    <div class="camping-field">
                        <label for="evt-time">Start time (optional)</label>
                        <input id="evt-time" type="time" class="form-control camping-input" @bind="editor.StartTime" />
                    </div>
                </div>
                <div class="camping-field">
                    <label for="evt-location">Location</label>
                    <input id="evt-location" class="form-control camping-input" @bind="editor.Location" placeholder="e.g. Grandma's house" />
                </div>
                <div class="camping-field">
                    <label for="evt-description">Details</label>
                    <textarea id="evt-description" class="form-control camping-input" rows="8" @bind="editor.Description" placeholder="Anything people should know"></textarea>
                </div>
                <div class="camping-field">
                    <label for="evt-bring-prompt">Potluck question (optional)</label>
                    <input id="evt-bring-prompt" class="form-control camping-input" @bind="editor.BringPrompt" placeholder="What do you plan to bring?" />
                </div>
                <label class="family-event-check">
                    <input type="checkbox" @bind="editor.ThemeVotingEnabled" /> Let people vote on potluck themes
                </label>
                @if (editor.IsNew && editor.ThemeVotingEnabled)
                {
                    <div class="camping-field">
                        <label for="evt-themes">Potluck themes to vote on (comma separated, optional)</label>
                        <input id="evt-themes" class="form-control camping-input" @bind="editor.ThemesText" placeholder="e.g. Mexican, BBQ, Free for all" />
                    </div>
                }
                <label class="family-event-check">
                    <input type="checkbox" @bind="editor.RsvpEnabled" /> Ask families to RSVP
                </label>
                @if (editor.RsvpEnabled)
                {
                    <div class="family-event-row">
                        <div class="camping-field">
                            <label for="evt-rsvp-goal">Families needed (optional)</label>
                            <input id="evt-rsvp-goal" type="number" min="1" max="100" class="form-control camping-input" @bind="editor.RsvpGoal" />
                        </div>
                        <div class="camping-field">
                            <label for="evt-rsvp-deadline">Reply by (optional)</label>
                            <input id="evt-rsvp-deadline" type="date" class="form-control camping-input" @bind="editor.RsvpDeadline" />
                        </div>
                    </div>
                }
                <div class="camping-field">
                    <label for="evt-signups">Extra sign-up lists, one per line as "Title: question" (optional)</label>
                    <textarea id="evt-signups" class="form-control camping-input" rows="3" @bind="editor.SignupListsText" placeholder="Skits: What is your family doing?"></textarea>
                    @if (!editor.IsNew)
                    {
                        <p class="camping-hint">Removing a line deletes that list and everything signed up on it.</p>
                    }
                </div>
                <div class="camping-bring-edit-actions">
                    <button class="btn btn-primary camping-btn" @onclick="SaveEditor" disabled="@isBusy">
                        @(isBusy ? "Saving..." : editor.IsNew ? "Create event" : "Save changes")
                    </button>
                    <button class="btn btn-secondary camping-btn camping-btn-secondary" @onclick="() => editor = null" disabled="@isBusy">Cancel</button>
                </div>
                @ErrorMessageFor("editor")
            </section>
        }

        @if (SelectedEvent == null)
        {
            <p class="camping-intro">No events yet.</p>
        }
        else
        {
            var familyEvent = SelectedEvent;
            <section class="camping-card">
                <h2>@familyEvent.Title</h2>
                <p class="family-event-when">@FormatWhen(familyEvent)</p>
                @if (!string.IsNullOrWhiteSpace(familyEvent.Location))
                {
                    <p class="family-event-location">
                        <a href="@MapUrl(familyEvent.Location)" target="_blank" rel="noopener">
                            <span class="oi oi-map-marker" aria-hidden="true"></span> @familyEvent.Location
                        </a>
                    </p>
                }
                @if (!string.IsNullOrWhiteSpace(familyEvent.Description))
                {
                    <p class="family-event-description">@familyEvent.Description</p>
                }

                @if (IsLocked)
                {
                    <p class="family-event-status is-locked">This event has passed. Everything below is read-only.</p>
                }
                else if (FamilyEventRules.IsPast(familyEvent, response.Today))
                {
                    <p class="family-event-status">This event has passed. Changes are allowed through @familyEvent.LastDay.AddDays(FamilyEventRules.EditableDaysAfterEvent).ToString("dddd, MMMM d", DisplayCulture).</p>
                }

                @if (isLuke && !IsLocked && editor == null)
                {
                    <div class="camping-bring-edit-actions">
                        <button class="btn btn-secondary camping-btn camping-btn-secondary" @onclick="() => StartEdit(familyEvent)">Edit details</button>
                        <button class="btn btn-outline-danger camping-btn" @onclick="() => DeleteEvent(familyEvent)" disabled="@isBusy">Delete event</button>
                    </div>
                }
                @ErrorMessageFor("event")
            </section>

            @if (!IsLocked)
            {
                <section class="camping-card">
                    <h2>Who are you?</h2>
                    <div class="camping-field">
                        <label for="voter-name">Your name</label>
                        <input id="voter-name" class="form-control camping-input" @ref="nameInput" @bind="name" @bind:after="OnNameChanged" placeholder="Enter your name" autocomplete="name" />
                    </div>
                    @ErrorMessageFor("name")
                    <p class="camping-hint">Your name is shown with your RSVP, sign-ups, votes, questions, and answers.</p>
                </section>
            }

            @if (familyEvent.RsvpEnabled)
            {
                var summary = FamilyEventRules.SummarizeRsvps(familyEvent.Rsvps);
                <section class="camping-card">
                    <h2>@(IsLocked ? "Who came" : "Are you coming?")</h2>
                    <p class="family-rsvp-summary">
                        <strong>@summary.GoingFamilies @(summary.GoingFamilies == 1 ? "family" : "families") going</strong>
                        @if (summary.GoingPeople > 0)
                        {
                            <span> · @summary.GoingPeople @(summary.GoingPeople == 1 ? "person" : "people")</span>
                            @if (summary.GoingAdults + summary.GoingKids > 0)
                            {
                                <span> (@summary.GoingAdults @(summary.GoingAdults == 1 ? "adult" : "adults"), @summary.GoingKids @(summary.GoingKids == 1 ? "kid" : "kids"))</span>
                            }
                        }
                        @if (summary.MaybeFamilies > 0)
                        {
                            <span> · @summary.MaybeFamilies maybe</span>
                        }
                    </p>
                    @if (familyEvent.RsvpGoal is int goal)
                    {
                        var remaining = Math.Max(0, goal - summary.GoingFamilies);
                        <div class="family-rsvp-goal">
                            <div class="family-rsvp-bar" role="progressbar" aria-valuemin="0" aria-valuemax="@goal" aria-valuenow="@summary.GoingFamilies">
                                <div class="family-rsvp-bar-fill" style="width: @(Math.Min(100, summary.GoingFamilies * 100 / goal))%"></div>
                            </div>
                            <span>@(remaining == 0 ? $"Goal of {goal} families reached!" : $"Need {remaining} more of {goal} families")</span>
                        </div>
                    }
                    @if (familyEvent.RsvpDeadline is DateTime deadline && !IsLocked)
                    {
                        <p class="family-event-status @(deadline.Date < Today ? "is-locked" : "")">
                            @(deadline.Date < Today ? "The reply-by date was" : "Please reply by") @deadline.ToString("dddd, MMMM d", DisplayCulture)
                        </p>
                    }

                    @if (!IsLocked)
                    {
                        <div @onfocusout="AutoSaveRsvp">
                        <div class="family-rsvp-buttons" role="group" aria-label="Your RSVP">
                            @foreach (var (status, label) in RsvpChoices)
                            {
                                <button type="button"
                                        class="btn camping-btn @(rsvpStatus == status ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="() => PickRsvpStatus(status)">
                                    @label
                                </button>
                            }
                        </div>
                        <div class="family-event-row">
                            <div class="camping-field">
                                <label for="rsvp-headcount">How many people?</label>
                                <input id="rsvp-headcount" type="number" min="0" max="@MaxHeadcount" class="form-control camping-input"
                                       @bind="rsvpHeadcount" @bind:event="oninput" @bind:after="SyncAttendeeRows" />
                            </div>
                            <div class="camping-field">
                                <label for="rsvp-note">Note (optional)</label>
                                <input id="rsvp-note" class="form-control camping-input" @bind="rsvpNote" placeholder="E.g. Won't be arriving till 6:00 PM due to work" />
                            </div>
                        </div>
                        @if (AttendeeRowCount > 0)
                        {
                            <div class="family-rsvp-people">
                                <p class="family-rsvp-people-hint">Who's coming? For kids, pick their age; for everyone else, pick Adult.</p>
                                @for (var i = 0; i < AttendeeRowCount; i++)
                                {
                                    var attendee = rsvpAttendees[i];
                                    var index = i + 1;
                                    <div class="family-rsvp-person">
                                        <input class="form-control camping-input" aria-label="Name of person @index"
                                               placeholder="Person @index name" @bind="attendee.Name" />
                                        <select class="form-select camping-input" aria-label="Age of person @index" @bind="attendee.Age">
                                            <option value="">Age…</option>
                                            <option value="@FamilyAttendeeAge.Adult">Adult</option>
                                            <option value="0">Under 1</option>
                                            @for (var age = 1; age <= FamilyAttendeeAge.MaxKidAge; age++)
                                            {
                                                <option value="@age">@age</option>
                                            }
                                        </select>
                                    </div>
                                }
                            </div>
                        }
                        <div class="camping-bring-edit-actions">
                            @if (FindRsvp(name) != null)
                            {
                                <button class="btn btn-secondary camping-btn camping-btn-secondary" @onclick="RemoveRsvp" disabled="@isBusy">Remove my RSVP</button>
                            }
                            <span class="family-rsvp-save-status" role="status">
                                @(string.IsNullOrEmpty(rsvpStatus) ? "Pick an answer above. Your RSVP saves automatically." : rsvpSaveStatus)
                            </span>
                        </div>
                        @ErrorMessageFor("rsvp")
                        </div>
                    }

                    @if (familyEvent.Rsvps.Count > 0)
                    {
                        <ul class="family-rsvp-list">
                            @foreach (var rsvp in familyEvent.Rsvps.OrderBy(r => RsvpOrder(r.Status)).ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase))
                            {
                                <li>
                                    <span class="family-rsvp-badge is-@rsvp.Status">@RsvpLabel(rsvp.Status)</span>
                                    <span class="family-qa-author">@rsvp.Name</span>
                                    @if (rsvp.Headcount is int count)
                                    {
                                        <span> (@count)</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(rsvp.Note))
                                    {
                                        <span class="family-rsvp-note"> — @rsvp.Note</span>
                                    }
                                    @if (rsvp.Attendees.Count > 0)
                                    {
                                        <div class="family-rsvp-note">@DescribeAttendees(rsvp.Attendees)</div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </section>
            }

            @if (!IsLocked)
            {
                <section class="camping-card">
                    <h2>Potluck</h2>
                    <div class="camping-field">
                        <label for="bringing">@(string.IsNullOrWhiteSpace(familyEvent.BringPrompt) ? "What do you plan to bring?" : familyEvent.BringPrompt)</label>
                        <input id="bringing" class="form-control camping-input" @bind="bringing" placeholder="e.g. chips and salsa" />
                    </div>

                    <button class="btn btn-primary camping-btn" @onclick="SaveParticipant" disabled="@isBusy">
                        Save what you're bringing
                    </button>
                    @ErrorMessageFor("bring")
                </section>
            }

            @if (familyEvent.ThemeVotingEnabled && (familyEvent.Potluck.Options.Count > 0 || !IsLocked))
            {
                <section class="camping-card">
                    <h2>What kind of potluck would you like?</h2>
                    @if (!IsLocked)
                    {
                        <p class="camping-hint">Options are sorted by score. Use the arrows to upvote or downvote.</p>
                    }

                    @if (SortedOptionRows.Count == 0)
                    {
                        <p>No options yet.</p>
                    }
                    else
                    {
                        <div class="camping-option-list">
                            @foreach (var row in SortedOptionRows)
                            {
                                var userRating = GetUserRating(row.Option.Id);
                                <div class="camping-option-row">
                                    <div class="camping-option-vote-col">
                                        <span class="camping-option-label">@row.Option.Label</span>
                                        <div class="camping-vote-controls">
                                            <button type="button"
                                                    class="camping-vote-btn @(userRating == 1 ? "is-active" : "")"
                                                    title="Upvote"
                                                    aria-label="Upvote @row.Option.Label"
                                                    disabled="@IsLocked"
                                                    @onclick="() => RateOption(row.Option.Id, 1)">
                                                ▲
                                            </button>
                                            <span class="camping-score" aria-hidden="true">@row.Score</span>
                                            <button type="button"
                                                    class="camping-vote-btn camping-vote-down @(userRating == -1 ? "is-active" : "")"
                                                    title="Downvote"
                                                    aria-label="Downvote @row.Option.Label"
                                                    disabled="@IsLocked"
                                                    @onclick="() => RateOption(row.Option.Id, -1)">
                                                ▼
                                            </button>
                                        </div>
                                        @if (!row.Option.IsBuiltIn && !IsLocked)
                                        {
                                            <button type="button"
                                                    class="camping-remove-btn"
                                                    title="Remove this option"
                                                    @onclick="() => RemoveOption(row.Option.Id)">
                                                Remove
                                            </button>
                                        }
                                    </div>

                                    <div class="camping-option-results-col">
                                        @VoterLine(row, isUp: true)
                                        @VoterLine(row, isUp: false)
                                        @if (row.Upvoters.Count == 0 && row.Downvoters.Count == 0)
                                        {
                                            <span class="camping-no-votes">No votes yet</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (!IsLocked)
                    {
                        <div class="camping-other-section">
                            <label for="other-option">Other</label>
                            <div class="camping-other-row">
                                <input id="other-option" class="form-control camping-input" @bind="otherText" placeholder="Suggest a new potluck option" />
                                <button class="btn btn-secondary camping-btn camping-btn-secondary" @onclick="AddOtherOption" disabled="@isBusy">
                                    Add option
                                </button>
                            </div>
                        </div>
                    }
                    @ErrorMessageFor("themes")
                </section>
            }

            <section class="camping-card">
                <h2>@(IsLocked ? "What everyone brought" : "What everyone is bringing")</h2>
                @if (BringItems.Count == 0)
                {
                    <p>No items listed.</p>
                }
                else
                {
                    <div class="camping-table-wrap family-event-bring-table">
                        <table class="table camping-table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Person</th>
                                    @if (!IsLocked)
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in BringItems)
                                {
                                    <tr>
                                        @if (IsEditingBringItem(item.Name))
                                        {
                                            <td colspan="3">
                                                <div class="camping-bring-edit">
                                                    <input class="form-control camping-input"
                                                           @bind="editingBringText"
                                                           @bind:event="oninput"
                                                           placeholder="What are you bringing?"
                                                           aria-label="Edit item for @item.Name" />
                                                    <div class="camping-bring-edit-actions">
                                                        <button type="button"
                                                                class="btn btn-primary camping-btn camping-bring-save-btn"
                                                                @onclick="() => SaveBringEdit(item.Name)"
                                                                disabled="@isBusy">
                                                            @(isBusy ? "Saving..." : "Save")
                                                        </button>
                                                        <button type="button"
                                                                class="btn btn-secondary camping-btn camping-btn-secondary"
                                                                @onclick="CancelBringEdit"
                                                                disabled="@isBusy">
                                                            Cancel
                                                        </button>
                                                        <span class="camping-bring-person">@item.Name</span>
                                                    </div>
                                                </div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>@item.Bringing</td>
                                            @if (IsLocked)
                                            {
                                                <td>@item.Name</td>
                                            }
                                            else
                                            {
                                                <td>
                                                    <button type="button" class="camping-edit-link" @onclick="() => LoadParticipant(item.Name)">@item.Name</button>
                                                </td>
                                                <td>
                                                    <button type="button" class="camping-item-edit-btn" @onclick="() => StartBringEdit(item)">Edit</button>
                                                </td>
                                            }
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @ErrorMessageFor("bring-table")
            </section>

            @foreach (var list in familyEvent.SignupLists)
            {
                var listId = list.Id;
                var mine = FindSignup(list, name);
                <section class="camping-card">
                    <h2>@list.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(list.Prompt))
                    {
                        <p class="camping-hint">@list.Prompt</p>
                    }

                    @if (!IsLocked)
                    {
                        <div class="camping-other-row">
                            <input class="form-control camping-input"
                                   value="@GetSignupDraft(listId, mine)"
                                   @oninput="e => signupDrafts[listId] = e.Value?.ToString() ?? string.Empty"
                                   placeholder="Your answer"
                                   aria-label="@list.Title" />
                            <button class="btn btn-secondary camping-btn camping-btn-secondary"
                                    @onclick="() => SaveSignup(listId, GetSignupDraft(listId, FindSignup(list, name)))"
                                    disabled="@isBusy">
                                Save
                            </button>
                            @if (mine != null)
                            {
                                <button class="btn btn-outline-secondary camping-btn" @onclick="() => SaveSignup(listId, string.Empty)" disabled="@isBusy">Remove</button>
                            }
                        </div>
                    }
                    @ErrorMessageFor($"signup:{listId}")

                    @if (list.Entries.Count == 0)
                    {
                        <p class="family-qa-empty">Nobody has signed up yet.</p>
                    }
                    else
                    {
                        <ul class="family-rsvp-list">
                            @foreach (var entry in list.Entries.OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase))
                            {
                                <li><span class="family-qa-author">@entry.Name</span>: @entry.Text</li>
                            }
                        </ul>
                    }
                </section>
            }

            <section class="camping-card">
                <h2>Questions &amp; answers</h2>

                @if (!IsLocked)
                {
                    <div class="camping-field">
                        <label for="new-question">Ask the group a question</label>
                        <textarea id="new-question" class="form-control camping-input" rows="2" @bind="newQuestionText" @bind:event="oninput" placeholder="e.g. Is there parking nearby?"></textarea>
                    </div>
                    <button class="btn btn-primary camping-btn" @onclick="AskQuestion" disabled="@(isBusy || string.IsNullOrWhiteSpace(newQuestionText))">
                        Ask question
                    </button>
                }
                @ErrorMessageFor("qa")

                @if (familyEvent.Questions.Count == 0)
                {
                    <p class="family-qa-empty">No questions yet.</p>
                }
                else
                {
                    <div class="family-qa-list">
                        @foreach (var question in familyEvent.Questions
                            .OrderByDescending(q => FamilyEventVotes.Score(q.Votes))
                            .ThenByDescending(q => q.AskedAt))
                        {
                            var questionId = question.Id;
                            <article class="family-qa-question family-qa-voted">
                                @VoteControls(question.Votes, "question", vote => VoteOnQuestion(question, vote))
                                <div class="family-qa-body">
                                    <div class="family-qa-meta">
                                        <span class="family-qa-author">@question.AskedBy</span>
                                        <span>asked @FormatPostTime(question.AskedAt)</span>
                                        @if (CanDelete(question.AskedBy))
                                        {
                                            <button type="button" class="camping-remove-btn" @onclick="() => DeleteQuestion(question)">Delete</button>
                                        }
                                    </div>
                                    <p class="family-qa-text">@question.Text</p>

                                    @if (question.Answers.Count == 0)
                                    {
                                        <p class="family-qa-unanswered">No answers yet.</p>
                                    }
                                    else
                                    {
                                        <div class="family-qa-answers">
                                            @foreach (var answer in question.Answers
                                                .OrderByDescending(a => FamilyEventVotes.Score(a.Votes))
                                                .ThenBy(a => a.AnsweredAt))
                                            {
                                                <div class="family-qa-answer family-qa-voted">
                                                    @VoteControls(answer.Votes, "answer", vote => VoteOnAnswer(question, answer, vote))
                                                    <div class="family-qa-body">
                                                        <div class="family-qa-meta">
                                                            <span class="family-qa-author">@answer.AnsweredBy</span>
                                                            <span>answered @FormatPostTime(answer.AnsweredAt)</span>
                                                            @if (CanDelete(answer.AnsweredBy))
                                                            {
                                                                <button type="button" class="camping-remove-btn" @onclick="() => DeleteAnswer(question, answer)">Delete</button>
                                                            }
                                                        </div>
                                                        <p class="family-qa-text">@answer.Text</p>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (!IsLocked)
                                    {
                                        <div class="camping-other-row family-qa-reply">
                                            <textarea class="form-control camping-input"
                                                      rows="1"
                                                      value="@GetAnswerDraft(questionId)"
                                                      @oninput="e => answerDrafts[questionId] = e.Value?.ToString() ?? string.Empty"
                                                      placeholder="Write an answer"
                                                      aria-label="Answer @question.AskedBy's question"></textarea>
                                            <button class="btn btn-secondary camping-btn camping-btn-secondary"
                                                    @onclick="() => AnswerQuestion(questionId)"
                                                    disabled="@(isBusy || string.IsNullOrWhiteSpace(GetAnswerDraft(questionId)))">
                                                Answer
                                            </button>
                                        </div>
                                    }
                                    @ErrorMessageFor($"qa:{questionId}")
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        }

        <section class="family-event-organizer">
            @if (isLuke)
            {
                @if (editor == null)
                {
                    <button class="btn btn-primary camping-btn" @onclick="StartNew">New event</button>
                }
                <button class="btn btn-secondary camping-btn camping-btn-secondary" @onclick="SendTestNotification" disabled="@isBusy">Send test notification</button>
                <button type="button" class="camping-edit-link" @onclick="SignOut">Organizer sign out</button>
                @if (notificationResults != null)
                {
                    <ul class="family-rsvp-list family-notify-results">
                        @foreach (var result in notificationResults)
                        {
                            <li>
                                <span class="family-rsvp-badge @(result.Sent ? "is-going" : result.Configured ? "is-maybe" : "")">
                                    @(result.Sent ? "Sent" : result.Configured ? "Failed" : "Not set up")
                                </span>
                                <span class="family-qa-author">@result.Channel</span>
                                @if (!result.Sent && !string.IsNullOrWhiteSpace(result.Error))
                                {
                                    <span class="family-rsvp-note"> — @result.Error</span>
                                }
                            </li>
                        }
                    </ul>
                }
            }
            else if (showSignIn)
            {
                <div class="camping-other-row">
                    <input class="form-control camping-input" type="password" @bind="signInCode" placeholder="Organizer code" aria-label="Organizer code" />
                    <button class="btn btn-secondary camping-btn camping-btn-secondary" @onclick="SignIn">Sign in</button>
                </div>
            }
            else
            {
                <button type="button" class="camping-edit-link" @onclick="() => showSignIn = true">Organizer sign in</button>
            }
            @ErrorMessageFor("organizer")
        </section>
    }
</main>

@code {
    private const string NameStorageKey = "camping-potluck-name";
    private static readonly CultureInfo DisplayCulture = CultureInfo.GetCultureInfo("en-US");

    [Parameter] public string? EventId { get; set; }

    private FamilyEventsResponse? response;
    private string name = "";
    private string bringing = "";
    private string otherText = "";
    private string? editingBringName;
    private string editingBringText = "";
    private bool isBusy;
    private bool isLuke;
    private bool showSignIn;
    private string signInCode = "";
    private EventEditor? editor;
    private string newQuestionText = "";
    private List<NotificationChannelResult>? notificationResults;
    private string rsvpStatus = "";
    private int? rsvpHeadcount;
    private readonly List<FamilyEventAttendee> rsvpAttendees = new();
    private readonly SemaphoreSlim rsvpWriteLock = new(1, 1);
    private bool rsvpSavePending;
    private string? lastSavedRsvp;
    private string rsvpSaveStatus = "";
    private string rsvpNote = "";
    private const int MaxHeadcount = 50;

    private int AttendeeRowCount => Math.Min(rsvpAttendees.Count, Math.Clamp(rsvpHeadcount ?? 0, 0, MaxHeadcount));
    private readonly Dictionary<string, string> signupDrafts = new(StringComparer.OrdinalIgnoreCase);

    private static readonly (string Status, string Label)[] RsvpChoices =
    {
        (FamilyRsvpStatus.Going, "We're in!"),
        (FamilyRsvpStatus.Maybe, "Maybe"),
        (FamilyRsvpStatus.No, "Can't make it")
    };
    private readonly Dictionary<string, string> answerDrafts = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> expandedVoterLists = new(StringComparer.OrdinalIgnoreCase);
    private string? errorMessage;
    private string? errorArea;
    private bool errorIsUnexpected;
    private ElementReference nameInput;
    private string? successMessage;

    private sealed class EventEditor
    {
        public string? Id { get; set; }
        public bool IsNew => Id == null;
        public string Title { get; set; } = "";
        public DateTime Date { get; set; }
        public DateTime? EndDate { get; set; }
        public TimeOnly? StartTime { get; set; }
        public string Location { get; set; } = "";
        public string Description { get; set; } = "";
        public string ThemesText { get; set; } = "";
        public bool ThemeVotingEnabled { get; set; } = true;
        public string BringPrompt { get; set; } = "";
