    };

    private void ToggleVoters(string expandKey)
    {
        if (!expandedVoterLists.Add(expandKey))
        {
            expandedVoterLists.Remove(expandKey);
        }
    }

    private void OnNameChanged() => LoadParticipant(name);

    /// <summary>Adds rows up to the headcount; extra rows are kept so lowering the number doesn't lose typing.</summary>
    private void SyncAttendeeRows()
    {
        var wanted = Math.Clamp(rsvpHeadcount ?? 0, 0, MaxHeadcount);
        while (rsvpAttendees.Count < wanted)
        {
            rsvpAttendees.Add(new FamilyEventAttendee
            {
                Name = rsvpAttendees.Count == 0 ? name.Trim() : ""
            });
        }
    }

    private static string DescribeAttendees(IEnumerable<FamilyEventAttendee> attendees) =>
        string.Join(", ", attendees
            .Select(a => (Name: a.Name.Trim(), Age: FamilyAttendeeAge.Label(a.Age)))
            .Where(a => a.Name.Length > 0 || a.Age.Length > 0)
            .Select(a => a.Name.Length == 0 ? a.Age : a.Age.Length == 0 ? a.Name : $"{a.Name} ({a.Age})"));

    private void LoadParticipant(string participantName)
    {
        name = participantName;
        bringing = FindParticipant(participantName)?.Bringing ?? "";
        var rsvp = FindRsvp(participantName);
        rsvpStatus = rsvp?.Status ?? "";
        rsvpHeadcount = rsvp?.Headcount;
        rsvpAttendees.Clear();
        rsvpAttendees.AddRange((rsvp?.Attendees ?? new List<FamilyEventAttendee>())
            .Select(a => new FamilyEventAttendee { Name = a.Name, Age = a.Age }));
        SyncAttendeeRows();
        rsvpNote = rsvp?.Note ?? "";
        lastSavedRsvp = DescribeRsvpRequest(BuildRsvpRequest());
        rsvpSaveStatus = rsvp == null ? "" : "Your RSVP is saved.";
        signupDrafts.Clear();
    }

    private PotluckParticipant? FindParticipant(string participantName)
    {
        if (string.IsNullOrWhiteSpace(participantName))
        {
            return null;
        }

        return SelectedEvent?.Potluck.Participants.FirstOrDefault(p =>
            string.Equals(p.Name, participantName.Trim(), StringComparison.OrdinalIgnoreCase));
