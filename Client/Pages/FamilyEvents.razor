    private async Task SignIn()
    {
        if (!string.Equals(signInCode.Trim(), ScheduleSubmitters.LukeAuthCode, StringComparison.Ordinal))
        {
            ShowError("organizer", "That code is not right.", isUnexpected: false);
            return;
        }

        await ScheduleSessionAuth.PersistSignedInNameAsync(JS, ScheduleSubmitters.LukeAuthCode);
        isLuke = true;
        showSignIn = false;
        signInCode = "";
        errorMessage = null;
    }

    private async Task SendTestNotification()
    {
        errorMessage = null;
        successMessage = null;
        notificationResults = null;
        isBusy = true;
        try
        {
            var result = await Http.PostAsJsonAsync("/api/notifications/test", new NotificationTestRequest { SubmittedBy = ScheduleSubmitters.LukeAuthCode });
            if (!result.IsSuccessStatusCode)
            {
                ShowError("organizer", $"Could not send a test notification. The server answered {(int)result.StatusCode} {result.ReasonPhrase}: {await result.Content.ReadAsStringAsync()}", isUnexpected: true);
                return;
            }

            notificationResults = await result.Content.ReadFromJsonAsync<List<NotificationChannelResult>>();
            successMessage = notificationResults?.Any(r => r.Sent) == true
                ? "Test sent. Check your phone."
                : "No notification channel delivered the test. See the details below.";
        }
        catch (Exception ex)
        {
            ShowError("organizer", $"Could not send a test notification. {ex.GetType().Name}: {ex.Message}", isUnexpected: true);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SignOut()
    {
        await ScheduleSessionAuth.ClearSignedInNameAsync(JS);
        isLuke = false;
        editor = null;
    }

    private void StartNew()
    {
        errorMessage = null;
        successMessage = null;
        editor = new EventEditor { Date = Today.AddDays(7) };
    }

    private void StartEdit(FamilyEvent familyEvent)
    {
        errorMessage = null;
        successMessage = null;
        editor = new EventEditor
        {
            Id = familyEvent.Id,
            Title = familyEvent.Title,
            Date = familyEvent.Date,
            EndDate = familyEvent.EndDate,
            StartTime = familyEvent.StartTime.HasValue ? TimeOnly.FromTimeSpan(familyEvent.StartTime.Value) : null,
            Location = familyEvent.Location,
            Description = familyEvent.Description,
            ThemeVotingEnabled = familyEvent.ThemeVotingEnabled,
            BringPrompt = familyEvent.BringPrompt,
            RsvpEnabled = familyEvent.RsvpEnabled,
            RsvpGoal = familyEvent.RsvpGoal,
            RsvpDeadline = familyEvent.RsvpDeadline,
            SignupListsText = string.Join("\n", familyEvent.SignupLists.Select(l =>
                string.IsNullOrWhiteSpace(l.Prompt) ? l.Title : $"{l.Title}: {l.Prompt}"))
        };
    }

    private async Task SaveEditor()
    {
        if (editor == null)
        {
            return;
        }

        var request = new FamilyEventDetailsRequest
        {
            SubmittedBy = ScheduleSubmitters.LukeAuthCode,
            Title = editor.Title,
            Date = editor.Date,
            EndDate = editor.EndDate,
            StartTime = editor.StartTime?.ToTimeSpan(),
            Location = editor.Location,
            Description = editor.Description,
            ThemeVotingEnabled = editor.ThemeVotingEnabled,
            BringPrompt = editor.BringPrompt,
            RsvpEnabled = editor.RsvpEnabled,
            RsvpGoal = editor.RsvpGoal,
            RsvpDeadline = editor.RsvpDeadline,
            SignupLists = ParseSignupLists(editor.SignupListsText),
            ThemeOptions = editor.ThemeVotingEnabled
                ? editor.ThemesText.Split(',').Select(t => t.Trim()).Where(t => t.Length > 0).ToList()
                : new List<string>()
        };

        var existingIds = (response?.Events ?? new()).Select(e => e.Id).ToHashSet();
        var isNew = editor.IsNew;
        var editId = editor.Id;

        var ok = await SendAsync(
            () => isNew
                ? Http.PostAsJsonAsync("/api/family-events", request)
                : Http.PutAsJsonAsync($"/api/family-events/{Uri.EscapeDataString(editId!)}", request),
            isNew ? "Could not create the event." : "Could not save the event.",
            "editor");

        if (!ok)
        {
            return;
        }

        editor = null;
        successMessage = isNew ? "Event created." : "Event updated.";
        var targetId = isNew
            ? response?.Events.FirstOrDefault(e => !existingIds.Contains(e.Id))?.Id
            : editId;

        if (targetId != null)
        {
            Nav.NavigateTo($"/FamilyEvents/{Uri.EscapeDataString(targetId)}");
        }
    }

    private static List<FamilyEventSignupList> ParseSignupLists(string text) =>
        (text ?? "")
            .Split('\n')
            .Select(line => line.Trim())
            .Where(line => line.Length > 0)
            .Select(line =>
            {
                var colon = line.IndexOf(':');
                return colon < 0
                    ? new FamilyEventSignupList { Title = line }
                    : new FamilyEventSignupList { Title = line[..colon].Trim(), Prompt = line[(colon + 1)..].Trim() };
            })
            .ToList();

    private async Task DeleteEvent(FamilyEvent familyEvent)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete \"{familyEvent.Title}\"? This removes all votes and sign-ups for it."))
        {
            return;
        }

        var ok = await SendAsync(
            () => Http.DeleteAsync($"/api/family-events/{Uri.EscapeDataString(familyEvent.Id)}?submittedBy={Uri.EscapeDataString(ScheduleSubmitters.LukeAuthCode)}"),
            "Could not delete the event.", "event");

        if (ok)
        {
            successMessage = "Event deleted.";
            Nav.NavigateTo("/FamilyEvents");
        }
    }
