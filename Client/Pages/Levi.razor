@page "/Levi"
@using BlazorApp.Shared
@inject HttpClient Http

<PageTitle>Cougars 2027 — Games &amp; Tournaments</PageTitle>



<div class="schedule-theme-kid-levi">

<h1>Cougars 2027</h1>

<p>2027 season schedule. Times show when set; otherwise listed as unscheduled.</p>



<style>

    .schedule-theme-kid-levi h1 {

      color: #1E40AF;

    }

    .schedule-theme-kid-levi > p {

      color: #2563EB;

      border-left: 4px solid #93C5FD;

      padding-left: 12px;

      margin-left: 0;

    }

    .schedule-theme-kid-levi h3 {

      color: #1E40AF;

    }

    .schedule-theme-kid-levi table {

      border-collapse: collapse;

      margin: auto;

      border: 2px solid #1E3A8A;

    }

    .schedule-theme-kid-levi th,

    .schedule-theme-kid-levi td {

      border: 1px solid #94A3B8;

      padding: 8px;

      text-align: left;

    }

    .schedule-theme-kid-levi th {

      background-color: #1E40AF;

      color: #F0F9FF;

    }

    .schedule-theme-kid-levi .schedule-table tbody tr td {

      background-color: #DBEAFE;

      color: #1E3A8A;

    }

    .schedule-theme-kid-levi .schedule-table tbody tr.row-theme-kids-multi td {

      background-color: transparent;

      background-image: var(--row-stripe-bg);

      color: #1F2937;

    }

    .schedule-theme-kid-levi footer {

      color: #64748B;

    }

    .schedule-theme-kid-levi .schedule-error {
      color: #B91C1C;
    }

  </style>

  @if (_loadRetry.IsRetryWaiting)
  {
    <ScheduleLoadRetryBanner Message="@(_loadRetry.RetryMessage ?? string.Empty)"
                             SecondsRemaining="@(_loadRetry.RetrySecondsRemaining ?? 0)"
                             TotalSeconds="@_loadRetry.RetryTotalSeconds" />
  }
  else if (!string.IsNullOrWhiteSpace(_errorMessage))
  {
    <p class="schedule-error">@_errorMessage</p>
  }

  @if (_loading)
  {
    <p>Loading schedule...</p>
  }
  else if (_upcoming.Count == 0 && string.IsNullOrWhiteSpace(_errorMessage) && !_loadRetry.IsRetryWaiting)
  {
    <h3>No upcoming games</h3>
  }





<div class="schedule-table-wrap">
<table class="schedule-table schedule-table-responsive">

    <thead>

        <tr>

            <th scope="col" class="schedule-cell-when">When</th>

            <th scope="col" class="schedule-cell-matchup">Event</th>

            <th scope="col" class="schedule-cell-kids">Kids</th>

            <th scope="col" class="schedule-cell-location">Location</th>

        </tr>

    </thead>

    <tbody>

    @foreach (var game in _upcoming)
    {

        <tr class="schedule-data-row @ScheduleKidThemes.GetRowClass(game, "Levi")" style="@ScheduleKidThemes.GetRowStyle(game)">

            <td class="schedule-cell-when">
                <div class="schedule-meta" aria-label="When">
                    @foreach (var part in game.ScheduleMetaParts)
                    {
                        <span class="schedule-meta-part">@part</span>
                    }
                </div>
            </td>

            <td class="schedule-cell-matchup">
                <div class="schedule-matchup">@game.MatchupTitle</div>
            </td>

            <td class="schedule-cell-kids">
                <ScheduleKidBadges ScheduleEvent="game" DefaultKidWhenEmpty="Levi" />
            </td>

            <td class="schedule-cell-location">
                <ScheduleLocationLink ScheduleEvent="game" />
            </td>

        </tr>

    }

    </tbody>

</table>
</div>





<footer>

    <li>&copy; @DateTime.Now.Year Luke Hammer </li>

    <li>Updated 9/27/2026</li>

</footer>

</div>

@code {
    private IReadOnlyList<Event> _upcoming = Array.Empty<Event>();
    private bool _loading = true;
    private string? _errorMessage;
    private readonly ScheduleLoadRetryPageState _loadRetry = new();

    private Task OnScheduleLoadRetryWaitingAsync(ScheduleLoadRetryUpdate update)
    {
        _loading = false;
        _errorMessage = null;
        _loadRetry.ApplyWaiting(update);
        return InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        _loadRetry.Clear();
        try
        {
            (_upcoming, _errorMessage) = await SportsScheduleApiClient.LoadUpcomingWithRetryAsync(
                Http,
                OnScheduleLoadRetryWaitingAsync,
                sport: SportNames.Baseball,
                kid: "Levi");
            if (_errorMessage == null)
            {
                _loadRetry.Clear();
            }
        }
        catch (Exception)
        {
            _errorMessage = "Could not display the schedule. Try reloading the page.";
            _upcoming = Array.Empty<Event>();
        }
        finally
        {
            _loading = false;
        }
    }
}

