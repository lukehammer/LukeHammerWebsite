@page "/photoshoot/brief"
@implements IDisposable
@inject PhotoShootStore Store
@inject PhotoShootBrowser Browser

<PageTitle>Photo Shoot · Photograph brief</PageTitle>

@if (Store.Shoot is { } doc)
{
    var brief = PhotographBriefWriter.Build(doc, reference => Store.Api.ImageUrl(doc.Id, reference));
    var text = PhotographBriefWriter.WriteText(brief);

    <header class="ps-page-head">
        <div>
            <h1 class="ps-h1">Photograph brief</h1>
            <p class="ps-muted">What each photograph is for, with links to the reference photos. Lighting, timing, and other shoot-day details are left out.</p>
        </div>
        <div class="ps-brief-actions">
            <a class="ps-btn ps-btn-outline" href="photoshoot/brief/json"><i class="bi bi-code-slash" aria-hidden="true"></i> JSON</a>
            <button type="button" class="ps-btn ps-btn-primary" @onclick="() => CopyAsync(text)"><i class="bi bi-clipboard" aria-hidden="true"></i> Copy</button>
            <button type="button" class="ps-btn ps-btn-outline" @onclick="() => DownloadAsync(doc, text)"><i class="bi bi-download" aria-hidden="true"></i> Download</button>
        </div>
    </header>
    @if (PsUi.Has(notice))
    {
        <p class="ps-muted ps-small" role="status">@notice</p>
    }

    <pre class="ps-brief-doc">@text</pre>
}

@code {
    private string notice = "";

    protected override void OnInitialized() => Store.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task CopyAsync(string brief)
    {
        notice = await Browser.CopyTextAsync(brief) ? "Copied." : "Could not copy. Use Download instead.";
    }

    private async Task DownloadAsync(PhotoShootDocument doc, string brief)
    {
        var name = string.Join("-", (doc.Name ?? "photo-brief").Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries)).ToLowerInvariant();
        if (string.IsNullOrEmpty(name))
        {
            name = "photo-brief";
        }

        await Browser.DownloadTextAsync(name + "-photograph-brief.txt", brief, "text/plain");
        notice = "Downloaded.";
    }

    public void Dispose() => Store.Changed -= OnChanged;
}
