@page "/photoshoot/photographer"
@layout PhotoShootLiveLayout
@implements IAsyncDisposable
@inject PhotoShootStore Store
@inject PhotoShootBrowser Browser

<PageTitle>Photographer · Photo Shoot</PageTitle>

@if (Store.Shoot is { } doc)
{
    var session = doc.Session;
    var progress = PhotoShootPlanner.Progress(doc);
        var live = PhotoShootPlanner.FindShot(doc, session.CurrentShotId);
        var current = live;
        var setup = current == null ? null : PhotoShootPlanner.FindSetup(doc, current.SetupId);
        var sequence = PhotoShootPlanner.OrderedShots(doc);
        var currentIndex = -1;
        if (current != null)
        {
            for (var i = 0; i < sequence.Count; i++)
            {
                if (sequence[i].Id == current.Id)
                {
                    currentIndex = i;
                }
            }
        }
        var next = currentIndex >= 0 && currentIndex < sequence.Count - 1 ? sequence[currentIndex + 1] : null;

    <div class="ps-photographer @(current == null ? "" : "ps-has-action-bar")">
        @if (!session.IsActive)
        {
            <div class="ps-waiting" role="status"><i class="bi bi-hourglass-split" aria-hidden="true"></i> Waiting for the director to start the session.@(current == null ? "" : " First up:")</div>
        }

        @if (current == null)
        {
            <div class="ps-panel ps-center">
                <p class="ps-big-message">@(progress.Total > 0 && progress.Completed == progress.Total ? "🎉 Every shot is complete!" : "No shot selected yet.")</p>
            </div>
        }
        else
        {
            <PsBrowseBar Doc="doc" CurrentId="@live?.Id" Navigate="GoTo" ImageUrl="reference => Store.Api.ImageUrl(doc.Id, reference)" />
            <section class="ps-live-shot @PsUi.StatusClass(current.Status)" aria-live="polite">
                <div class="ps-live-shot-meta">
                    <span class="ps-seq-big">@PhotoShootPlanner.OrderNumber(doc, current.Id)<span class="ps-muted">/@progress.Total</span></span>
                    <span class="ps-badge @PsUi.PriorityClass(current.Priority)">@PhotoShootLabels.Priority(current.Priority)</span>
                    <span class="ps-badge @PsUi.StatusClass(current.Status)"><i class="bi @PsUi.StatusIcon(current.Status)" aria-hidden="true"></i> @PhotoShootLabels.Status(current.Status)</span>
                    <span class="ps-badge ps-badge-plain"><i class="bi bi-clock" aria-hidden="true"></i> ~@PsUi.Minutes(current.EstimatedMinutes)</span>
                </div>
                <h1 class="ps-live-title">@current.Title</h1>
                @if (setup != null)
                {
                    <div class="ps-muted ps-small">Setup @setup.Sequence: @setup.Name</div>
                }

                <PsReferenceSlots Doc="doc" Shot="current" ImageUrl="reference => Store.Api.ImageUrl(doc.Id, reference)" OnEnlarge="ShowReference" />

                <div class="ps-photo-key">
                    <div class="ps-key-card">
                        <div class="ps-key-label"><i class="bi bi-aspect-ratio" aria-hidden="true"></i> Framing</div>
                        <div class="ps-key-value">@(PsUi.Has(current.Framing) ? current.Framing : "—") · @PhotoShootLabels.Orientation(current.Orientation)</div>
                        @if (current.NegativeSpace != NegativeSpaceDirection.None)
                        {
                            <div class="ps-key-sub">@PhotoShootLabels.NegativeSpace(current.NegativeSpace)</div>
                        }
                        @if (PsUi.Has(current.RecommendedCrop))
                        {
                            <div class="ps-key-sub">Crop: @current.RecommendedCrop</div>
                        }
                    </div>
                    @if (PsUi.Has(current.PhotographerInstructions))
                    {
                        <div class="ps-key-card ps-key-wide">
                            <div class="ps-key-label"><i class="bi bi-camera" aria-hidden="true"></i> Direction</div>
                            <div class="ps-key-value">@current.PhotographerInstructions</div>
                        </div>
                    }
                    <div class="ps-key-card">
                        <div class="ps-key-label"><i class="bi bi-lightbulb" aria-hidden="true"></i> Lighting</div>
                        <div class="ps-key-value">@(PsUi.Has(current.LightingNotes) ? current.LightingNotes : PsUi.Has(setup?.Lighting) ? setup!.Lighting : "Setup lighting")</div>
                    </div>
                    <div class="ps-key-card">
                        <div class="ps-key-label"><i class="bi bi-person-arms-up" aria-hidden="true"></i> Pose</div>
                        <div class="ps-key-value">@(PsUi.Has(current.BodyPosition) ? current.BodyPosition : "—")</div>
                        @if (PsUi.Has(current.HandPosition))
                        {
                            <div class="ps-key-sub">Hands: @current.HandPosition</div>
                        }
                    </div>
                    <div class="ps-key-card">
                        <div class="ps-key-label"><i class="bi bi-emoji-surprise" aria-hidden="true"></i> Expression</div>
                        <div class="ps-key-value">@(PsUi.Has(current.FacialExpression) ? current.FacialExpression : "—")</div>
                        @if (PsUi.Has(current.EyeDirection))
                        {
                            <div class="ps-key-sub">Eyes: @current.EyeDirection</div>
                        }
                    </div>
                    <div class="ps-key-card">
                        <div class="ps-key-label"><i class="bi bi-magic" aria-hidden="true"></i> Equipment / props required</div>
                        @if (current.Equipment.Count == 0)
                        {
                            <div class="ps-key-value">No special props required.</div>
                        }
                        else
                        {
                            <div class="ps-key-value">@string.Join(" · ", current.Equipment.Select(item => $"{item.Name} × {item.Quantity} · {PhotoShootLabels.Supplier(item.Supplier)}{(item.Optional ? " · optional" : "")}"))</div>
                        }
                    </div>
                </div>
            </section>

            <div class="ps-action-bar" role="group" aria-label="Shot actions">
                <div class="ps-action-bar-row ps-action-bar-pair">
                    @if (live != null && live.Status != ShotStatus.Completed)
                    {
                        <button type="button" class="ps-btn ps-btn-success ps-action-main" disabled="@busy" @onclick="() => Do(SessionAction.CompleteCurrent)">
                            <i class="bi bi-check-lg" aria-hidden="true"></i> Got it — mark complete
                        </button>
                    }
                    <button type="button" class="ps-btn @(session.NextRequestedUtc != null ? "ps-btn-outline" : "ps-btn-teal") ps-action-main" disabled="@(busy || session.NextRequestedUtc != null)" @onclick="() => Do(SessionAction.RequestNext)">
                        <i class="bi bi-hand-index-thumb" aria-hidden="true"></i> @(session.NextRequestedUtc != null ? "Director notified — waiting…" : "Ready for next shot")
                    </button>
                </div>
            </div>

            <div class="ps-photo-foot">
                @if (next != null)
                {
                    <div class="ps-up-next">
                        <span class="ps-muted">Up next:</span> <strong>@next.Title</strong>
                        <div>@PhotoShootGear.ChangeNote(doc, current, next)</div>
                        @if (next.SetupId != current.SetupId)
                        {
                            var nextSetup = PhotoShootPlanner.FindSetup(doc, next.SetupId);
                            <div class="ps-setup-change"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Setup change: @(nextSetup?.Name ?? "Unassigned")</div>
                        }
                    </div>
                }

                <details class="ps-live-more">
                    <summary>More detail (acting note, references, purpose)</summary>
                    @if (PsUi.Has(current.PerformerInstructions))
                    {
                        <p><strong>Acting note:</strong> @current.PerformerInstructions</p>
                    }
                    <PsShotReferences Shot="current" ShowSearchPhrases="false" />
                    @if (PsUi.Has(current.MarketingPurpose))
                    {
                        <p class="ps-small"><strong>Use:</strong> @current.MarketingPurpose</p>
                    }
                    @if (PsUi.Has(setup?.CameraPosition))
                    {
                        <p class="ps-small"><strong>Camera:</strong> @setup!.CameraPosition</p>
                    }
                </details>

                <div class="ps-note-form">
                    <input class="form-control ps-input" placeholder="Note to the director…" maxlength="500" @bind="noteText" @bind:event="oninput" aria-label="Note to the director" />
                    <button type="button" class="ps-btn ps-btn-outline" disabled="@(busy || string.IsNullOrWhiteSpace(noteText))" @onclick="AddNote">Send</button>
                </div>
            </div>
        }

        <div class="ps-photo-status">
            <p class="ps-marker-jump"><a href="photoshoot/marker">Shot marker</a></p>
            <div class="ps-live-progress ps-live-progress-foot">
                <div><strong>@progress.Completed</strong>/@progress.Total done</div>
                <div class="ps-live-progress-must"><i class="bi bi-star-fill" aria-hidden="true"></i> @progress.MustHaveCompleted/@progress.MustHaveTotal must-have</div>
                <div class="ps-mini-track" aria-hidden="true"><div class="ps-mini-fill" style="width:@(progress.Percent)%"></div></div>
            </div>
        </div>
    </div>

    <PsLightbox Src="@(enlarged == null ? null : Store.Api.ImageUrl(doc.Id, enlarged))" Alt="@(enlarged?.Title ?? "")" SourceUrl="@enlarged?.SourceUrl" OnClose="() => enlarged = null" />
}

@code {
    private bool busy;
    private PhotoReference? enlarged;
    private string noteText = "";

    private Task GoTo(string shotId) => Do(SessionAction.SetCurrent, shotId);

    private Task ShowReference(PhotoReference reference)
    {
        enlarged = reference;
        return Task.CompletedTask;
    }

    protected override void OnInitialized()
    {
        Store.Changed += OnChanged;
        Store.StartLive();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Browser.KeepAwakeAsync(true);
        }
    }

    private async Task Do(SessionAction action, string shotId = "")
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            await Store.SessionAsync(action, shotId);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task AddNote()
    {
        var text = noteText;
        busy = true;
        try
        {
            if (await Store.SessionAsync(SessionAction.AddNote, text: text))
            {
                noteText = "";
            }
        }
        finally
        {
            busy = false;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Store.StopLive();
        Store.Changed -= OnChanged;
        await Browser.KeepAwakeAsync(false);
    }
}
