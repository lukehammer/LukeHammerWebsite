@page "/photoshoot/brief/json"
@implements IDisposable
@inject PhotoShootStore Store

<PageTitle>Photo Shoot · Photograph brief JSON</PageTitle>

@if (Store.Shoot is { } doc)
{
    var json = PhotographBriefWriter.WriteJson(PhotographBriefWriter.Build(doc, reference => Store.Api.ImageUrl(doc.Id, reference)));

    <header class="ps-page-head">
        <div>
            <h1 class="ps-h1">Photograph brief JSON</h1>
            <p class="ps-muted">The same list as the text brief: what each photograph is for, and links to the reference photos.</p>
        </div>
        <a class="ps-btn ps-btn-outline" href="photoshoot/brief">Text brief</a>
    </header>

    <pre class="ps-brief-doc">@json</pre>
}

@code {
    protected override void OnInitialized() => Store.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Store.Changed -= OnChanged;
}
