@page "/photoshoot/review"
@implements IDisposable
@inject PhotoReviewState State
@inject NavigationManager Nav

<PageTitle>Lucky Luke Magic · Photo shoot review</PageTitle>

@if (State.Summary is not { } summary)
{
    @if (PrUi.Has(State.Error))
    {
        <div class="ps-panel ps-gate"><p class="ps-error-text">@State.Error</p><button class="ps-btn ps-btn-primary" @onclick="() => State.EnsureSummaryAsync(true)">Retry</button></div>
    }
    else
    {
        <div class="ps-panel ps-center" role="status"><div class="spinner-border ps-spinner" aria-hidden="true"></div><p>Loading the review…</p></div>
    }
}
else
{
    var counts = summary.Counts;
    <header class="pr-hero">
        <h1>Lucky Luke Magic photo shoot review</h1>
        <p class="pr-lead">Every planned shot next to what the camera actually captured. Rate photos, comment, and suggest poses for the next shoot.</p>
        <div class="pr-tiles">
            <a class="pr-tile" href="photoshoot/review?show=all"><span class="pr-tile-n">@counts.PlannedShots</span><span>planned shots</span></a>
            <a class="pr-tile pr-tile-review" href="photoshoot/review?coverage=with"><span class="pr-tile-n">@counts.ShotsWithPhotos</span><span>represented by selected photos</span></a>
            <a class="pr-tile" href="photoshoot/review?view=photos"><span class="pr-tile-n">@counts.Photos</span><span>selected originals</span></a>
            <a class="pr-tile pr-tile-success pr-tile-provisional" href="photoshoot/review?status=Successful"><span class="pr-tile-n">@counts.ByProvisionalStatus.GetValueOrDefault(ShotReviewStatus.Successful)</span><span>successful <em>@PrUi.Split(counts, ShotReviewStatus.Successful)</em></span></a>
            <a class="pr-tile pr-tile-partial pr-tile-provisional" href="photoshoot/review?status=PartiallySuccessful"><span class="pr-tile-n">@counts.ByProvisionalStatus.GetValueOrDefault(ShotReviewStatus.PartiallySuccessful)</span><span>partially successful <em>@PrUi.Split(counts, ShotReviewStatus.PartiallySuccessful)</em></span></a>
            <a class="pr-tile pr-tile-missing pr-tile-provisional" href="photoshoot/review?status=NotCaptured"><span class="pr-tile-n">@counts.ByProvisionalStatus.GetValueOrDefault(ShotReviewStatus.NotCaptured)</span><span>not captured <em>@PrUi.Split(counts, ShotReviewStatus.NotCaptured)</em></span></a>
            <a class="pr-tile pr-tile-owner" href="photoshoot/review?confirmed=1"><span class="pr-tile-n">@counts.OwnerConfirmed</span><span>reviewed by Luke</span></a>
            <a class="pr-tile" href="photoshoot/second-shoot"><span class="pr-tile-n">@counts.SecondShootItems</span><span>in the second-shoot plan</span></a>
        </div>
        <p class="pr-note pr-note-provisional">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <strong>Provisional</strong> statuses are Codex's capture assessments of the selected photos. Luke has reviewed
            <strong>@counts.OwnerConfirmed</strong> of @counts.PlannedShots shots; his decision always replaces the provisional one.
            Photo matches are marked slate-supported, inferred or approximate.
        </p>
        <ol class="pr-steps">
            <li><button type="button" class="pr-link-btn" @onclick="OpenName">Enter your name</button>. No password.</li>
            <li>Open a shot, compare the plan with the photos, and <strong>rate each photo 1–10</strong>.</li>
            <li>Comment, reply, or <a href="photoshoot/suggestions">suggest a pose</a>. Missing and weak shots go into the <a href="photoshoot/second-shoot">second-shoot plan</a>.</li>
        </ol>
        <p class="pr-small"><a href="photoshoot/walkthrough"><i class="bi bi-easel" aria-hidden="true"></i> New here? Read the walkthrough of how this shoot was planned and reviewed.</a></p>
    </header>

    <div class="pr-toolbar">
        <input type="search" class="form-control ps-input pr-search" placeholder="Search shots, poses, notes…" @bind="query" @bind:event="oninput" @bind:after="SyncUrl" aria-label="Search" />
        <select class="form-select ps-input" @bind="status" @bind:after="SyncUrl" aria-label="Filter by status">
            <option value="">Any status</option>
            @foreach (var option in PhotoReviewLabels.Statuses)
            {
                <option value="@option">@PhotoReviewLabels.Status(option)</option>
            }
        </select>
        <label class="ps-toggle" title="Only shots Luke has reviewed"><input type="checkbox" @bind="confirmedOnly" @bind:after="SyncUrl" /> Luke-reviewed only</label>
        <select class="form-select ps-input" @bind="coverage" @bind:after="SyncUrl" aria-label="Filter by photos">
            <option value="">With or without photos</option>
            <option value="with">Has selected photos</option>
            <option value="without">No photo found</option>
        </select>
        <select class="form-select ps-input" @bind="evidence" @bind:after="SyncUrl" aria-label="Filter by match evidence">
            <option value="">Any evidence</option>
            <option value="SlateSupported">Slate-supported</option>
            <option value="Inferred">Inferred</option>
            <option value="Approximate">Approximate</option>
        </select>
        <label class="ps-toggle"><input type="checkbox" @bind="warningsOnly" @bind:after="SyncUrl" /> Warnings</label>
        <label class="ps-toggle"><input type="checkbox" @bind="mustOnly" @bind:after="SyncUrl" /> Must-have</label>
        <div class="pr-segmented" role="radiogroup" aria-label="View">
            <label><input type="radio" name="pr-view" checked="@(view != "photos")" @onchange="@(() => SetView("shots"))" /> Shots</label>
            <label><input type="radio" name="pr-view" checked="@(view == "photos")" @onchange="@(() => SetView("photos"))" /> Photos</label>
        </div>
    </div>

    <nav class="pr-cats" aria-label="Categories">
        <button type="button" class="pr-cat @(category == "" ? "pr-cat-on" : "")" @onclick="@(() => SetCategory(""))">All <span>@summary.Shots.Count</span></button>
        @foreach (var cat in summary.Categories)
        {
            <button type="button" class="pr-cat @(category == cat.Slug ? "pr-cat-on" : "")" @onclick="() => SetCategory(cat.Slug)">
                @cat.Label <span>@cat.ShotCount shots · @cat.PhotoCount photos</span>
            </button>
        }
    </nav>

    var shots = FilteredShots(summary);
    @if (view == "photos")
    {
        var photos = FilteredPhotos(summary, shots);
        <p class="pr-muted pr-small">@photos.Count photos</p>
        <div class="pr-photo-grid">
            @foreach (var photo in photos)
            {
                var shot = State.Shot(photo.ShotId);
                <a class="pr-photo-tile" href="@PrUi.PhotoLink(photo.Id)">
                    @if (photo.Thumb.Widths.Count > 0)
                    {
                        <img src="@State.Api.ThumbUrl(photo, 480)" alt="@PrUi.Alt(shot?.Title ?? "", 0)" loading="lazy" width="@photo.Thumb.Width" height="@photo.Thumb.Height" />
                    }
                    <span class="pr-photo-tile-meta">
                        <span>@(shot == null ? "" : PrUi.Number(shot.Number)) @shot?.Title</span>
                        <span><PrEvidence Evidence="photo.Evidence" /> @(photo.RatingCount > 0 ? $"★ {photo.Average:0.0} ({photo.RatingCount})" : "") @(photo.MyRating is int m ? $"· you {m}" : "")</span>
                    </span>
                    @if (photo.HasWarnings)
                    {
                        <span class="pr-warn-dot" title="Has a warning"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></span>
                    }
                </a>
            }
        </div>
    }
    else
    {
        <p class="pr-muted pr-small">@shots.Count of @summary.Shots.Count planned shots</p>
        @foreach (var group in shots.GroupBy(s => s.Category).OrderBy(g => g.Key))
        {
            <section class="pr-group">
                <h2 class="pr-group-title">@PhotoReviewLabels.Category(group.Key) <span class="pr-muted">@group.Count() shots</span></h2>
                @if (group.Key == ReviewCategory.KidsAndVolunteers && group.All(s => s.PhotoIds.Count == 0))
                {
                    <p class="pr-note">No children appear in the supplied albums, so these shots are all waiting for a second shoot with volunteers.</p>
                }
                <div class="pr-shot-grid">
                    @foreach (var shot in group)
                    {
                        var cover = State.Photo(shot.CoverPhotoId);
                        <a class="pr-shot-card @(shot.PhotoIds.Count == 0 ? "pr-shot-card-empty" : "")" href="@PrUi.ShotLink(shot.ShotId)">
                            <div class="pr-shot-thumb">
                                @if (cover != null && cover.Thumb.Widths.Count > 0)
                                {
                                    <img src="@State.Api.ThumbUrl(cover, 480)" alt="@PrUi.Alt(shot.Title, 0)" loading="lazy" />
                                    @if (shot.PhotoIds.Count > 1)
                                    {
                                        <span class="pr-count">+@(shot.PhotoIds.Count - 1)</span>
                                    }
                                }
                                else
                                {
                                    <span class="pr-noimg"><i class="bi bi-camera" aria-hidden="true"></i>No photo found yet</span>
                                }
                            </div>
                            <div class="pr-shot-body">
                                <div class="pr-shot-title"><span class="pr-num">@PrUi.Number(shot.Number)</span> @shot.Title @(shot.MustHave ? "★" : "")</div>
                                <div class="pr-shot-meta">
                                    <PrStatus Status="shot.Status" Confirmed="shot.StatusConfirmed" Suggested="shot.SuggestedStatus" SuggestedBy="@shot.SuggestedBy" />
                                    @if (shot.BestEvidence is MatchEvidence best)
                                    {
                                        <PrEvidence Evidence="best" />
                                    }
                                    @if (shot.HasWarnings)
                                    {
                                        <span class="pr-warn" title="A photo on this shot has a warning"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
                                    }
                                    @if (shot.CommentCount + shot.OpenSuggestions > 0)
                                    {
                                        <span class="pr-muted pr-small"><i class="bi bi-chat" aria-hidden="true"></i> @(shot.CommentCount + shot.OpenSuggestions)</span>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }
        @if (shots.Count == 0)
        {
            <p class="ps-panel">No shots match these filters.</p>
        }
    }
}

@code {
    private string query = "";
    private string status = "";
    private string coverage = "";
    private string evidence = "";
    private string category = "";
    private string view = "shots";
    private bool warningsOnly;
    private bool mustOnly;
    private bool confirmedOnly;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        ReadUrl();
        Nav.LocationChanged += OnLocation;
        await State.EnsureSummaryAsync(force: true);
    }

    private void OnLocation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!e.IsNavigationIntercepted) return;
        ReadUrl();
        InvokeAsync(StateHasChanged);
    }

    private void ReadUrl()
    {
        var q = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        query = q.Get("q") ?? "";
        status = q.Get("status") ?? "";
        coverage = q.Get("coverage") ?? "";
        evidence = q.Get("evidence") ?? "";
        category = q.Get("c") ?? "";
        view = q.Get("view") == "photos" ? "photos" : "shots";
        warningsOnly = q.Get("warnings") == "1";
        mustOnly = q.Get("must") == "1";
        confirmedOnly = q.Get("confirmed") == "1";
    }

    private void SyncUrl()
    {
        var parts = new List<string>();
        void Add(string key, string value) { if (!string.IsNullOrEmpty(value)) parts.Add(key + "=" + Uri.EscapeDataString(value)); }
        Add("q", query);
        Add("status", status);
        Add("coverage", coverage);
        Add("evidence", evidence);
        Add("c", category);
        Add("view", view == "photos" ? "photos" : "");
        Add("warnings", warningsOnly ? "1" : "");
        Add("must", mustOnly ? "1" : "");
        Add("confirmed", confirmedOnly ? "1" : "");
        Nav.NavigateTo("photoshoot/review" + (parts.Count > 0 ? "?" + string.Join("&", parts) : ""), new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private void SetCategory(string slug)
    {
        category = slug;
        SyncUrl();
    }

    private void SetView(string value)
    {
        view = value;
        SyncUrl();
    }

    private void OpenName()
    {
        State.OpenNamePrompt();
    }

    private List<ShotSummary> FilteredShots(ReviewSummaryResponse summary)
    {
        IEnumerable<ShotSummary> shots = summary.Shots;
        if (category != "") shots = shots.Where(s => PhotoReviewLabels.CategorySlug(s.Category) == category);
        if (Enum.TryParse<ShotReviewStatus>(status, out var st)) shots = shots.Where(s => s.ProvisionalStatus == st);
        if (confirmedOnly) shots = shots.Where(s => s.StatusConfirmed);
        if (coverage == "with") shots = shots.Where(s => s.PhotoIds.Count > 0);
        if (coverage == "without") shots = shots.Where(s => s.PhotoIds.Count == 0);
        if (Enum.TryParse<MatchEvidence>(evidence, out var ev)) shots = shots.Where(s => s.PhotoIds.Any(id => State.Photo(id)?.Evidence == ev));
        if (warningsOnly) shots = shots.Where(s => s.HasWarnings);
        if (mustOnly) shots = shots.Where(s => s.MustHave);
        var text = query.Trim();
        if (text.Length > 0)
        {
            shots = shots.Where(s =>
                s.Title.Contains(text, StringComparison.OrdinalIgnoreCase)
                || s.Summary.Contains(text, StringComparison.OrdinalIgnoreCase)
                || s.SetupName.Contains(text, StringComparison.OrdinalIgnoreCase)
                || s.CoverageNotes.Contains(text, StringComparison.OrdinalIgnoreCase)
                || PrUi.Number(s.Number).Contains(text)
                || s.PhotoIds.Any(id => State.Photo(id)?.PhotoKey.Contains(text.Replace(' ', '-'), StringComparison.OrdinalIgnoreCase) == true));
        }

        return shots.ToList();
    }

    private List<PhotoSummary> FilteredPhotos(ReviewSummaryResponse summary, List<ShotSummary> shots)
    {
        var ids = shots.Select(s => s.ShotId).ToHashSet();
        IEnumerable<PhotoSummary> photos = summary.Photos.Where(p => ids.Contains(p.ShotId));
        if (category != "") photos = photos.Where(p => PhotoReviewLabels.CategorySlug(p.Category) == category || ids.Contains(p.ShotId));
        if (Enum.TryParse<MatchEvidence>(evidence, out var ev)) photos = photos.Where(p => p.Evidence == ev);
        if (warningsOnly) photos = photos.Where(p => p.HasWarnings);
        return photos.OrderBy(p => State.Shot(p.ShotId)?.Number ?? 999).ThenBy(p => p.PhotoKey).ToList();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocation;
    }
}
