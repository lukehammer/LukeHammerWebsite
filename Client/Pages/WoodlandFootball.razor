@page "/WoodlandFootball"
@using BlazorApp.Client
@using BlazorApp.Shared
@inject HttpClient Http

<PageTitle>Woodland Football — JV Schedule</PageTitle>



<div class="schedule-theme-kid-cohen">

<h1>Woodland Football</h1>

<p>Woodland JV tackle schedule. Only upcoming games are shown.</p>



<style>

    .schedule-theme-kid-cohen h1 {

      color: #1B4332;

    }

    .schedule-theme-kid-cohen > p {

      color: #2D6A4F;

      border-left: 4px solid #A8A9AD;

      padding-left: 12px;

      margin-left: 0;

    }

    .schedule-theme-kid-cohen h3 {

      color: #1B4332;

    }

    .schedule-theme-kid-cohen table {

      border-collapse: collapse;

      margin: auto;

      border: 2px solid #40916C;

    }

    .schedule-theme-kid-cohen th,

    .schedule-theme-kid-cohen td {

      border: 1px solid #52796F;

      padding: 8px;

      text-align: left;

    }

    .schedule-theme-kid-cohen th {

      background-color: #2D6A4F;

      color: #F0F0F0;

    }

    .schedule-theme-kid-cohen footer {

      color: #52796F;

    }

    .schedule-theme-kid-cohen .schedule-error {
      color: #B91C1C;
    }

  </style>
<style>@((MarkupString)KidThemeColorsLoader.SportPageCss(".schedule-theme-kid-cohen", "Cohen"))</style>

@if (_loadRetry.IsRetryWaiting)
{
    <ScheduleLoadRetryBanner Message="@(_loadRetry.RetryMessage ?? string.Empty)"
                             SecondsRemaining="@(_loadRetry.RetrySecondsRemaining ?? 0)"
                             TotalSeconds="@_loadRetry.RetryTotalSeconds" />
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <p class="schedule-error">@_errorMessage</p>
}

@if (_loading)
{
    <p>Loading schedule...</p>
}
else if (_upcoming.Count == 0 && string.IsNullOrWhiteSpace(_errorMessage) && !_loadRetry.IsRetryWaiting)
{
    <h3>No upcoming JV games</h3>
}



<div class="schedule-table-wrap">
<table class="schedule-table schedule-table-responsive">

    <thead>

        <tr>

            <th scope="col" class="schedule-cell-when">When</th>

            <th scope="col" class="schedule-cell-matchup">Event</th>

            <th scope="col" class="schedule-cell-kids">Kids</th>

            <th scope="col" class="schedule-cell-location">Location</th>

        </tr>

    </thead>

    <tbody>

    @foreach (var game in _upcoming)
    {

        <tr class="schedule-data-row @ScheduleKidThemes.GetRowClass(game, "Cohen")" style="@ScheduleKidThemes.GetRowStyle(game)">

            <td class="schedule-cell-when">
                <div class="schedule-meta" aria-label="When">
                    @foreach (var part in game.ScheduleMetaParts)
                    {
                        <span class="schedule-meta-part">@part</span>
                    }
                </div>
            </td>

            <td class="schedule-cell-matchup">
                <div class="schedule-matchup">@game.MatchupTitle</div>
            </td>

            <td class="schedule-cell-kids">
                <ScheduleKidBadges ScheduleEvent="game" DefaultKidWhenEmpty="Cohen" />
            </td>

            <td class="schedule-cell-location">
                <ScheduleLocationLink ScheduleEvent="game" />
            </td>

        </tr>

    }

    </tbody>

</table>
</div>



<footer>

    <li>&copy; @DateTime.Now.Year Luke Hammer</li>

    <li>Updated 9/27/2026</li>

</footer>

</div>

@code {
    private IReadOnlyList<Event> _upcoming = Array.Empty<Event>();
    private bool _loading = true;
    private string? _errorMessage;
    private readonly ScheduleLoadRetryPageState _loadRetry = new();

    private Task OnScheduleLoadRetryWaitingAsync(ScheduleLoadRetryUpdate update)
    {
        _loading = false;
        _errorMessage = null;
        _loadRetry.ApplyWaiting(update);
        return InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        _loadRetry.Clear();
        try
        {
            (_upcoming, _errorMessage) = await SportsScheduleApiClient.LoadUpcomingWithRetryAsync(
                Http,
                OnScheduleLoadRetryWaitingAsync,
                sport: SportNames.Football);
            if (_errorMessage == null)
            {
                _loadRetry.Clear();
            }
        }
        finally
        {
            _loading = false;
        }
    }
}

