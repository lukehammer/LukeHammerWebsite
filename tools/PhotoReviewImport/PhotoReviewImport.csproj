<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local-only importer for the photo review (see docs/photoshoot/ARTIFACT_MANIFEST.md). Not deployed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PhotoReviewImport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
    <!-- MIT licensed. Used only to read dimensions and make browsing thumbnails; artifacts are never re-encoded. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Shared.csproj" />
    <Compile Include="..\..\Api\PhotoReviewStore.cs" Link="PhotoReviewStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTest" />
  </ItemGroup>

</Project>
